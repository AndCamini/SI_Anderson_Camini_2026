@rendermode InteractiveServer
@implements IDisposable

@inject NavigationManager NavigationManager

<div class="brand-row">
    <a class="brand" href="">
        <svg class="brand-mecha" viewBox="0 0 40 64" aria-hidden="true">
            <path d="M24 2 C8 16 6 36 20 62" />
            <path d="M28 6 C14 20 13 38 26 60" />
            <path d="M32 12 C21 24 20 40 31 56" />
            <path d="M35 20 C28 29 27 40 35 50" />
        </svg>
        <span class="brand-texto">
            <span class="brand-nome">EMERSON</span>
            <span class="brand-linha">
                <span class="brand-hair">HAIR</span>
                <span class="brand-correa">Correa</span>
            </span>
        </span>
    </a>
</div>

<input type="checkbox" title="Menu de navegação" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="menu">
        <NavLink class="menu-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-door" aria-hidden="true"></i>
            <span>Início</span>
        </NavLink>

        <NavLink class="menu-link" href="agenda">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            <span>Agenda</span>
        </NavLink>

        @foreach (var grupo in grupos)
        {
            var aberto = gruposAbertos.Contains(grupo.Titulo);
            <div class="menu-grupo @(aberto ? "aberto" : "") @(GrupoAtivo(grupo) ? "ativo" : "")">
                <button type="button" class="menu-grupo-titulo" @onclick="() => AlternarGrupo(grupo.Titulo)" @onclick:stopPropagation="true">
                    <i class="bi @grupo.Icone" aria-hidden="true"></i>
                    <span>@grupo.Titulo</span>
                    <i class="bi bi-chevron-down menu-seta" aria-hidden="true"></i>
                </button>
                @if (aberto)
                {
                    <div class="menu-itens">
                        @foreach (var item in grupo.Itens)
                        {
                            <NavLink class="menu-link menu-subitem" href="@item.Href">
                                <i class="bi @item.Icone" aria-hidden="true"></i>
                                <span>@item.Titulo</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }
    </nav>

    <div class="menu-rodape">
        <i class="bi bi-instagram" aria-hidden="true"></i> emer_soncorreahair
    </div>
</div>

@code {
    private record ItemMenu(string Titulo, string Href, string Icone);
    private record GrupoMenu(string Titulo, string Icone, ItemMenu[] Itens);

    private readonly GrupoMenu[] grupos =
    {
        new("Localidades", "bi-globe2", new ItemMenu[]
        {
            new("Países", "paises", "bi-flag"),
            new("Estados", "estados", "bi-map"),
            new("Cidades", "cidades", "bi-geo-alt")
        }),
        new("Cadastros", "bi-person-vcard", new ItemMenu[]
        {
            new("Clientes", "clientes", "bi-people"),
            new("Funcionários", "funcionarios", "bi-person-badge"),
            new("Categorias", "categorias", "bi-tags"),
            new("Produtos", "produtos", "bi-box-seam"),
            new("Serviços", "servicos", "bi-scissors"),
            new("Fornecedores", "fornecedores", "bi-building"),
            new("Transportadores", "transportadores", "bi-truck"),
            new("Veículos", "veiculos", "bi-car-front")
        }),
        new("Financeiro", "bi-cash-coin", new ItemMenu[]
        {
            new("Condições de Pagamento", "condicoes-pagamento", "bi-credit-card"),
            new("Formas de Pagamento", "formas-pagamento", "bi-wallet2"),
            new("Compras", "compras", "bi-cart3")
        })
    };

    private readonly HashSet<string> gruposAbertos = new();
    private string currentUrl = string.Empty;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        AbrirGrupoAtual();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        AbrirGrupoAtual();
        InvokeAsync(StateHasChanged);
    }

    private void AbrirGrupoAtual()
    {
        var grupo = grupos.FirstOrDefault(GrupoAtivo);
        if (grupo != null) gruposAbertos.Add(grupo.Titulo);
    }

    private bool GrupoAtivo(GrupoMenu grupo)
    {
        var rota = currentUrl.Split('?', '#')[0];
        return grupo.Itens.Any(i => rota.Equals(i.Href, StringComparison.OrdinalIgnoreCase));
    }

    private void AlternarGrupo(string titulo)
    {
        if (!gruposAbertos.Remove(titulo)) gruposAbertos.Add(titulo);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
