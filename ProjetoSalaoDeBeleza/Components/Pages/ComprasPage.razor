                    <h5 class="modal-title"><i class="bi bi-credit-card me-2"></i>Condições de pagamento</h5>
                    <button type="button" class="btn-close" @onclick="() => modalCondicoesAberto = false"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="() => { cadastroCondicaoAberto = !cadastroCondicaoAberto; erroNovaCondicao = null; }">
                            + Nova condição
                        </button>
                    </div>

                    @if (cadastroCondicaoAberto)
                    {
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white">Nova condição de pagamento</div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(erroNovaCondicao))
                                {
                                    <div class="alert alert-danger py-1">@erroNovaCondicao</div>
