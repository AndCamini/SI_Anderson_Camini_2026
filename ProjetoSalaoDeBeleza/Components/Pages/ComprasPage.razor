@page "/compras"
@rendermode InteractiveServer
@using ProjetoSalaoDeBeleza.Models
@using ProjetoSalaoDeBeleza.Services
@inject ComprasService comprasService
@inject FornecedoresService fornecedoresService
@inject TransportadoresService transportadoresService
@inject ProdutosService produtosService
@inject CategoriasService categoriasService
@inject CondicaoPagamentoService condicaoPagamentoService
@inject FormasPagamentoService formasPagamentoService
@inject CidadesService cidadesService

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Compras</h3>
    <button class="btn btn-primary" @onclick="AbrirModalNovo">
        <i class="bi bi-plus-lg me-1"></i> Nova compra
    </button>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger alert-dismissible">
        @mensagemErro
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}

@* ===================== LISTAGEM ===================== *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nota</th>
                    <th>Fornecedor</th>
                    <th>Emissão</th>
                    <th>Chegada</th>
                    <th>Transportadora</th>
                    <th class="text-end">Total</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!listaCompras.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nenhuma compra cadastrada.</td></tr>
                }
                @foreach (var c in listaCompras)
                {
                    <tr>
                        <td><span class="badge bg-secondary">@c.Modelo / @c.Serie / @c.NumeroNota</span></td>
                        <td>@c.CodFornecedor - @c.oFornecedor?.RazaoSocial</td>
                        <td>@c.DataEmissao.ToString("dd/MM/yyyy")</td>
                        <td>@c.DataChegada.ToString("dd/MM/yyyy")</td>
                        <td>@(c.oTransportador?.Nome ?? "—")</td>
                        <td class="text-end fw-semibold">@ComprasCalculos.TotalNota(c).ToString("C2")</td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => AbrirModalExcluir(c)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ===================== MODAL NOVA COMPRA ===================== *@
@if (modalFormAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.6)">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-cart-plus me-2"></i>Nova nota de entrada</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalForm"></button>
                </div>
                <div class="modal-body bg-light">

                    @if (!string.IsNullOrEmpty(mensagemErroModal))
                    {
                        <div class="alert alert-danger">@mensagemErroModal</div>
                    }

                    @* ---------- DADOS DA NOTA ---------- *@
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold">Dados da nota</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-4 col-md-1">
                                    <label class="form-label">Modelo</label>
                                    <input type="number" class="form-control text-end" @bind="compraAtual.Modelo"
                                           disabled="@dadosNotaConfirmados" />
                                </div>
                                <div class="col-4 col-md-1">
                                    <label class="form-label">Série</label>
                                    <input type="number" class="form-control text-end" @bind="compraAtual.Serie"
                                           disabled="@dadosNotaConfirmados" />
                                </div>
                                <div class="col-4 col-md-2">
                                    <label class="form-label">Número</label>
                                    <input class="form-control text-end" inputmode="numeric" maxlength="9"
                                           @bind="NumeroNotaTexto" @bind:event="oninput" disabled="@dadosNotaConfirmados" />
                                </div>
                                <div class="col-12 col-md-8">
                                    <label class="form-label">Fornecedor</label>
                                    <div class="input-group">
                                        <input class="form-control" readonly
                                               value="@(fornecedorSelecionado == null ? "" : $"{fornecedorSelecionado.CodFornecedor} - {fornecedorSelecionado.RazaoSocial} - {FormatarCnpj(fornecedorSelecionado.CNPJ)}")"
                                               placeholder="Nenhum selecionado" />
                                        <button type="button" class="btn btn-outline-secondary"
                                                @onclick="AbrirConsultaFornecedores" disabled="@dadosNotaConfirmados">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Data de emissão</label>
                                    <InputDate @bind-Value="compraAtual.DataEmissao" class="form-control"
                                               max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled="@dadosNotaConfirmados" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Data de chegada</label>
                                    <InputDate @bind-Value="compraAtual.DataChegada" class="form-control"
                                               max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled="@dadosNotaConfirmados" />
                                </div>
                                <div class="col-12 col-md-8 d-flex align-items-end justify-content-end">
                                    @if (!dadosNotaConfirmados)
                                    {
                                        <button type="button" class="btn btn-primary" @onclick="ConfirmarDadosNota">
                                            <i class="bi bi-arrow-right-circle me-1"></i>Confirmar dados da nota
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-success small">
                                            <i class="bi bi-lock-fill me-1"></i>Dados da nota confirmados
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <fieldset disabled="@(!dadosNotaConfirmados)" class="@(dadosNotaConfirmados ? "" : "opacity-50")">

                    @* ---------- PRODUTOS ---------- *@
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Produtos</span>
                            <div class="d-flex align-items-center gap-3">
                                <span class="small text-muted">
                                    Total dos produtos:
                                    <strong class="text-dark">@TotalProdutos.ToString("C2")</strong>
                                </span>
                                <button type="button" class="btn btn-sm btn-primary" @onclick="AbrirConsultaProdutos"
                                        disabled="@parcelasGeradas">
                                    <i class="bi bi-search me-1"></i>Adicionar produto
                                </button>
                            </div>
                        </div>
                        @if (parcelasGeradas)
                        {
                            <div class="alert alert-warning rounded-0 mb-0 py-1 small">
                                Parcelas geradas. Para alterar produtos ou custos, clique em "Refazer parcelas".
                            </div>
                        }
                        <div class="card-body p-0">
                            @if (!compraAtual.Itens.Any())
                            {
                                <div class="text-center text-muted py-4">Nenhum produto adicionado.</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="min-width:220px">Produto</th>
                                                <th>Und.</th>
                                                <th class="text-end" style="width:80px">Qtd.</th>
                                                <th class="text-end" style="width:130px">Val. unitário</th>
                                                <th class="text-end" style="width:90px">Desc. %</th>
                                                <th class="text-end" style="width:110px">Desc. R$</th>
                                                <th class="text-end">Total item</th>
                                                <th class="text-end">Custo (frete)</th>
                                                <th class="text-end">Custo unitário</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in compraAtual.Itens)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="text-muted small">@item.CodProduto -</span>
                                                        @item.oProduto?.Produto
                                                    </td>
                                                    <td>@item.oProduto?.UnidadeMedida</td>
                                                    <td>
                                                        <input type="number" min="1" class="form-control form-control-sm text-end"
                                                               @bind="item.Quantidade" @bind:after="() => AlterouItem(item)"
                                                               disabled="@parcelasGeradas" />
                                                    </td>
                                                    <td>
                                                        <input type="number" step="0.000001" class="form-control form-control-sm text-end"
                                                               @bind="item.PrecoUnitario" @bind:after="() => AlterouItem(item)"
                                                               disabled="@parcelasGeradas" />
                                                    </td>
                                                    <td>
                                                        <input type="number" step="0.0001" class="form-control form-control-sm text-end"
                                                               @bind="item.DescontoPercentual" @bind:after="() => AlterouDescontoPercentual(item)"
                                                               disabled="@parcelasGeradas" />
                                                    </td>
                                                    <td>
                                                        <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                                               @bind="item.DescontoValor" @bind:after="() => AlterouDescontoValor(item)"
                                                               disabled="@parcelasGeradas" />
                                                    </td>
                                                    <td class="text-end fw-semibold">@item.Total.ToString("N2")</td>
                                                    <td class="text-end">@item.CustoRateado.ToString("N6")</td>
                                                    <td class="text-end fw-semibold">@item.CustoUnitario.ToString("N6")</td>
                                                    <td class="text-end">
                                                        <button type="button" class="btn btn-link text-danger p-0"
                                                                disabled="@parcelasGeradas"
                                                                @onclick="() => RemoverItem(item)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>

                    @* ---------- FRETE E TRANSPORTADORA ---------- *@
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold">Frete e transportadora</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Transportadora</label>
                                    <div class="input-group">
                                        <input class="form-control" readonly
                                               value="@(transportadorSelecionado == null ? "" : $"{transportadorSelecionado.CodTransportador} - {transportadorSelecionado.Nome}")"
                                               placeholder="Sem transportadora" />
                                        @if (transportadorSelecionado != null)
                                        {
                                            <button type="button" class="btn btn-outline-secondary" @onclick="LimparTransportador">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-outline-secondary" @onclick="AbrirConsultaTransportadores">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-4 col-md-2">
                                    <label class="form-label">Frete</label>
                                    <input type="number" step="0.01" class="form-control text-end"
                                           @bind="compraAtual.Frete" @bind:after="Recalcular" disabled="@parcelasGeradas" />
                                </div>
                                <div class="col-4 col-md-2">
                                    <label class="form-label">Seguro</label>
                                    <input type="number" step="0.01" class="form-control text-end"
                                           @bind="compraAtual.Seguro" @bind:after="Recalcular" disabled="@parcelasGeradas" />
                                </div>
                                <div class="col-4 col-md-2">
                                    <label class="form-label">Outras despesas</label>
                                    <input type="number" step="0.01" class="form-control text-end"
                                           @bind="compraAtual.OutrasDespesas" @bind:after="Recalcular" disabled="@parcelasGeradas" />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ---------- FECHAMENTO ---------- *@
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold">Fechamento</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label text-muted">Total dos produtos</label>
                                    <input class="form-control text-end" value="@TotalProdutos.ToString("N2")" readonly />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-muted">Frete + seguro + outras despesas</label>
                                    <input class="form-control text-end" value="@TotalCustos.ToString("N2")" readonly />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Total da nota</label>
                                    <input class="form-control text-end fw-bold bg-success text-white" value="@TotalNota.ToString("N2")" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ---------- CONDIÇÃO DE PAGAMENTO ---------- *@
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold">Condição de pagamento</div>
                        <div class="card-body">
                            <div class="row g-3 align-items-end mb-3">
                                <div class="col-md-5">
                                    <label class="form-label">Condição de pagamento</label>
                                    <div class="input-group">
                                        <input class="form-control" readonly
                                               value="@(condicaoSelecionada == null ? "" : $"{condicaoSelecionada.CodCondicao} - {condicaoSelecionada.Descricao}")"
                                               placeholder="Nenhuma selecionada" />
                                        <button type="button" class="btn btn-outline-secondary"
                                                @onclick="AbrirConsultaCondicoes" disabled="@parcelasGeradas">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Forma de pagamento</label>
                                    <div class="input-group">
                                        <input class="form-control" readonly
                                               value="@(formaSelecionada == null ? "" : $"{formaSelecionada.CodFormaPagamento} - {formaSelecionada.FormaPagamento}")"
                                               placeholder="Nenhuma selecionada" />
                                        <button type="button" class="btn btn-outline-secondary" @onclick="AbrirConsultaFormas">
                                            <i class="bi bi-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-3 text-end">
                                    @if (!parcelasGeradas)
                                    {
                                        <button type="button" class="btn btn-primary w-100" @onclick="GerarParcelas">
                                            <i class="bi bi-calculator me-1"></i>Gerar parcelas
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-warning w-100" @onclick="RefazerParcelas">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>Refazer parcelas
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (compraAtual.Parcelas.Any())
                            {
                                <table class="table table-sm mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:120px">Parcela</th>
                                            <th style="width:180px">Data de vencimento</th>
                                            <th class="text-end">Valor da parcela</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in compraAtual.Parcelas)
                                        {
                                            <tr>
                                                <td>@p.Numero / @compraAtual.Parcelas.Count</td>
                                                <td>@p.Vencimento.ToString("dd/MM/yyyy")</td>
                                                <td class="text-end">@p.Valor.ToString("C2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="text-muted small">Selecione a condição e clique em "Gerar parcelas".</div>
                            }
                        </div>
                    </div>

                    @* ---------- OBSERVAÇÕES ---------- *@
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <label class="form-label">Observações</label>
                            <InputTextArea @bind-Value="compraAtual.Observacoes" class="form-control" rows="2"
                                           placeholder="Anotações sobre a compra" />
                        </div>
                    </div>

                    </fieldset>
                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FecharModalForm">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Salvar" disabled="@(!dadosNotaConfirmados)">
                        <i class="bi bi-check-lg me-1"></i>Salvar compra
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ===================== POPUP CONSULTA DE PRODUTOS ===================== *@
@if (modalProdutosAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5); z-index:1060">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-search me-2"></i>Consulta de produtos</h5>
                    <button type="button" class="btn-close" @onclick="FecharConsultaProdutos"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(erroProdutos))
                    {
                        <div class="alert alert-danger py-1">@erroProdutos</div>
                    }

                    <div class="d-flex gap-2 mb-3">
                        <input class="form-control" placeholder="Buscar por código, referência, código de barras ou nome"
                               @bind="termoProduto" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap"
                                @onclick="() => { cadastroProdutoAberto = !cadastroProdutoAberto; erroProdutos = null; }">
                            + Novo produto
                        </button>
                    </div>

                    @if (cadastroProdutoAberto)
                    {
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white">Novo produto</div>
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <label class="form-label">Nome</label>
                                        <InputText @bind-Value="novoProduto.Produto" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Referência</label>
                                        <InputText @bind-Value="novoProduto.Referencia" class="form-control form-control-sm" maxlength="30" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Código de barras</label>
                                        <InputText @bind-Value="novoProduto.CodigoBarras" class="form-control form-control-sm" maxlength="14" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label">Categoria</label>
                                        <InputSelect @bind-Value="novoProduto.CodCategoria" class="form-select form-select-sm">
                                            <option value="0">Selecione...</option>
                                            @foreach (var cat in listaCategorias)
                                            {
                                                <option value="@cat.CodCategoria">@cat.Categoria</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Unidade</label>
                                        <InputText @bind-Value="novoProduto.UnidadeMedida" class="form-control form-control-sm" maxlength="10" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Preço de venda</label>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                               @bind="novoProduto.PrecoVenda" />
                                    </div>
                                    <div class="col-md-2 d-flex align-items-end">
                                        <button type="button" class="btn btn-primary btn-sm w-100" @onclick="SalvarNovoProduto">Salvar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="@(produtoDetalhe == null ? "col-12" : "col-lg-8")">
                            <table class="table table-sm table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Cód.</th>
                                        <th>Referência</th>
                                        <th>Cód. barras</th>
                                        <th>Produto</th>
                                        <th>Und.</th>
                                        <th class="text-end">Estoque</th>
                                        <th class="text-end">Custo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!ProdutosFiltrados.Any())
                                    {
                                        <tr><td colspan="7" class="text-center text-muted py-3">Nenhum produto encontrado.</td></tr>
                                    }
                                    @foreach (var p in ProdutosFiltrados)
                                    {
                                        <tr style="cursor:pointer" class="@(produtoDetalhe?.CodProduto == p.CodProduto ? "table-primary" : "")"
                                            @onclick="() => produtoDetalhe = p"
                                            @ondblclick="() => AdicionarProduto(p)">
                                            <td>@p.CodProduto</td>
                                            <td>@p.Referencia</td>
                                            <td>@p.CodigoBarras</td>
                                            <td>@p.Produto</td>
                                            <td>@p.UnidadeMedida</td>
                                            <td class="text-end">@p.Estoque</td>
                                            <td class="text-end">@p.PrecoCusto.ToString("N4")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="small text-muted">Clique para ver os detalhes. Dois cliques adicionam à nota.</div>
                        </div>

                        @if (produtoDetalhe != null)
                        {
                            <div class="col-lg-4">
                                <div class="card border-0 bg-light">
                                    <div class="card-body">
                                        <h6 class="mb-3">@produtoDetalhe.CodProduto - @produtoDetalhe.Produto</h6>
                                        <dl class="row small mb-3">
                                            <dt class="col-5">Referência</dt>
                                            <dd class="col-7">@(produtoDetalhe.Referencia ?? "—")</dd>
                                            <dt class="col-5">Cód. barras</dt>
                                            <dd class="col-7">@(produtoDetalhe.CodigoBarras ?? "—")</dd>
                                            <dt class="col-5">Categoria</dt>
                                            <dd class="col-7">@produtoDetalhe.oCategoria?.Categoria</dd>
                                            <dt class="col-5">Unidade</dt>
                                            <dd class="col-7">@produtoDetalhe.UnidadeMedida</dd>
                                            <dt class="col-5">Estoque</dt>
                                            <dd class="col-7">@produtoDetalhe.Estoque</dd>
                                            <dt class="col-5">Custo atual</dt>
                                            <dd class="col-7">@produtoDetalhe.PrecoCusto.ToString("N6")</dd>
                                            <dt class="col-5">Preço venda</dt>
                                            <dd class="col-7">@produtoDetalhe.PrecoVenda.ToString("C2")</dd>
                                            <dt class="col-5">Descrição</dt>
