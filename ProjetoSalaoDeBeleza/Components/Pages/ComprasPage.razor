                                        <label class="form-label">Juros %</label>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="novaCondicao.Juros" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Desconto %</label>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="novaCondicao.Desconto" />
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
                                    <span class="fw-semibold small">Parcelas</span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AdicionarParcelaNovaCondicao">
                                        + Adicionar parcela
                                    </button>
                                </div>
                                @if (novaCondicao.Parcelas.Any())
                                {
                                    var totalPct = novaCondicao.Parcelas.Sum(p => p.Percentual);
                                    <table class="table table-sm mb-1">
                                        <thead class="table-light">
                                            <tr><th>Nº</th><th class="text-end">Dias</th><th class="text-end">%</th><th></th></tr>
