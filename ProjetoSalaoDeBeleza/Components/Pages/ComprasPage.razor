@code {
    // Listas
    private List<Compras> listaCompras = new();
    private List<Fornecedores> listaFornecedores = new();
    private List<Transportadores> listaTransportadores = new();
    private List<Produtos> listaProdutos = new();
    private List<Categorias> listaCategorias = new();
    private List<CondicaoPagamento> listaCondicoes = new();
    private List<FormasPagamento> listaFormas = new();
    private List<Cidades> listaCidades = new();

    // Estado da tela
    private Compras compraAtual = new();
    private Compras? compraExcluir;
    private CondicaoPagamento? condicaoSelecionada;
    private Fornecedores? fornecedorSelecionado;
    private Transportadores? transportadorSelecionado;
    private FormasPagamento? formaSelecionada;
    private bool dadosNotaConfirmados;
    private bool modalFormAberto;
    private bool modalExcluirAberto;
    private string? mensagemErro;
    private string? mensagemSucesso;
    private string? mensagemErroModal;

    // Popups
    private bool modalProdutosAberto;
    private bool cadastroProdutoAberto;
    private string termoProduto = string.Empty;
    private Produtos? produtoDetalhe;
    private Produtos novoProduto = new();
    private string? erroProdutos;

    private bool modalCondicoesAberto;
    private bool cadastroCondicaoAberto;
    private CondicaoPagamento novaCondicao = new();
    private string? erroNovaCondicao;

    private bool modalFornecedoresAberto;
    private bool cadastroFornecedorAberto;
    private string termoFornecedor = string.Empty;
    private Fornecedores novoFornecedor = new();
    private string? erroNovoFornecedor;

    private bool modalTransportadoresAberto;
    private bool cadastroTransportadorAberto;
    private string termoTransportador = string.Empty;
    private Transportadores novoTransportador = new();
    private string? erroNovoTransportador;

    private bool modalFormasAberto;
    private bool cadastroFormaAberto;
    private FormasPagamento novaForma = new();
    private string? erroNovaForma;

    // Totais
    private decimal TotalProdutos => ComprasCalculos.TotalProdutos(compraAtual);
    private decimal TotalCustos => ComprasCalculos.TotalCustos(compraAtual);
    private decimal TotalNota => ComprasCalculos.TotalNota(compraAtual);
    private bool parcelasGeradas => compraAtual.Parcelas.Any();

    // Número da nota: só dígitos, no máximo 9
    private string NumeroNotaTexto
    {
        get => compraAtual.NumeroNota == 0 ? string.Empty : compraAtual.NumeroNota.ToString();
        set
        {
            var digitos = new string((value ?? string.Empty).Where(char.IsDigit).Take(9).ToArray());
            compraAtual.NumeroNota = digitos.Length == 0 ? 0 : int.Parse(digitos);
        }
    }

    private IEnumerable<Produtos> ProdutosFiltrados
    {
        get
        {
            var ativos = listaProdutos.Where(p => p.Ativo);
            if (string.IsNullOrWhiteSpace(termoProduto)) return ativos;

            var termo = termoProduto.Trim().ToUpper();
            return ativos.Where(p =>
                p.CodProduto.ToString() == termo ||
                (p.CodigoBarras ?? "") == termo ||
                (p.Referencia ?? "").ToUpper().Contains(termo) ||
                p.Produto.ToUpper().Contains(termo));
        }
    }

    private IEnumerable<Fornecedores> FornecedoresFiltrados
    {
        get
        {
            var ativos = listaFornecedores.Where(f => f.Ativo);
            if (string.IsNullOrWhiteSpace(termoFornecedor)) return ativos;

            var termo = termoFornecedor.Trim().ToUpper();
            var digitos = new string(termo.Where(char.IsDigit).ToArray());
            return ativos.Where(f =>
                f.CodFornecedor.ToString() == termo ||
                f.RazaoSocial.ToUpper().Contains(termo) ||
                (f.NomeFantasia ?? "").ToUpper().Contains(termo) ||
                (digitos.Length > 0 && f.CNPJ.Contains(digitos)));
        }
    }

    private IEnumerable<Transportadores> TransportadoresFiltrados
    {
        get
        {
            var ativos = listaTransportadores.Where(t => t.Ativo);
            if (string.IsNullOrWhiteSpace(termoTransportador)) return ativos;

            var termo = termoTransportador.Trim().ToUpper();
            var digitos = new string(termo.Where(char.IsDigit).ToArray());
            return ativos.Where(t =>
                t.CodTransportador.ToString() == termo ||
                t.Nome.ToUpper().Contains(termo) ||
                (digitos.Length > 0 && ((t.CPF ?? "").Contains(digitos) || (t.CNPJ ?? "").Contains(digitos))));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        listaFornecedores = await fornecedoresService.GetFornecedoresAsync();
        listaTransportadores = await transportadoresService.GetTransportadoresAsync();
        listaProdutos = await produtosService.GetProdutosAsync();
        listaCategorias = await categoriasService.GetCategoriasAsync();
        listaCondicoes = (await condicaoPagamentoService.GetCondicoesPagamentoAsync()).Where(c => c.Ativo).ToList();
        listaFormas = (await formasPagamentoService.GetFormasPagamentoAsync()).Where(f => f.Ativo).ToList();
        listaCidades = await cidadesService.GetCidadesAsync();
        await CarregarCompras();
    }

    private async Task CarregarCompras()
    {
        listaCompras = await comprasService.GetComprasAsync();
    }

    // ---------- Modal principal ----------
    private void AbrirModalNovo()
    {
        compraAtual = new Compras { DataEmissao = DateTime.Today, DataChegada = DateTime.Today };
        LimparSelecoes();
        mensagemErroModal = null;
        modalFormAberto = true;
    }

    private void FecharModalForm()
    {
        modalFormAberto = false;
        compraAtual = new Compras();
        LimparSelecoes();
        mensagemErroModal = null;
    }

    private void LimparSelecoes()
    {
        condicaoSelecionada = null;
        fornecedorSelecionado = null;
        transportadorSelecionado = null;
        formaSelecionada = null;
        dadosNotaConfirmados = false;
        modalFornecedoresAberto = modalTransportadoresAberto = modalFormasAberto = false;
    }

    private async Task ConfirmarDadosNota()
    {
        mensagemErroModal = null;

        if (compraAtual.Modelo <= 0) { mensagemErroModal = "Informe o modelo da nota."; return; }
        if (compraAtual.Serie <= 0) { mensagemErroModal = "Informe a série da nota."; return; }
        if (compraAtual.NumeroNota <= 0) { mensagemErroModal = "Informe o número da nota."; return; }
        if (fornecedorSelecionado == null || compraAtual.CodFornecedor == 0) { mensagemErroModal = "Selecione o fornecedor."; return; }
        if (compraAtual.DataEmissao == default) { mensagemErroModal = "Informe a data de emissão."; return; }
        if (compraAtual.DataChegada == default) { mensagemErroModal = "Informe a data de chegada."; return; }
        if (compraAtual.DataEmissao.Date > DateTime.Today)
        { mensagemErroModal = "Data de emissão não pode ser posterior a hoje."; return; }
        if (compraAtual.DataChegada.Date > DateTime.Today)
        { mensagemErroModal = "Data de chegada não pode ser posterior a hoje."; return; }
        if (compraAtual.DataChegada.Date < compraAtual.DataEmissao.Date)
        { mensagemErroModal = "Data de chegada não pode ser anterior à data de emissão."; return; }

        if (await comprasService.ExisteCompraAsync(compraAtual.Modelo, compraAtual.Serie, compraAtual.NumeroNota, compraAtual.CodFornecedor))
        { mensagemErroModal = "Esta nota já foi lançada para este fornecedor."; return; }

        dadosNotaConfirmados = true;
    }

    private void AbrirConsultaFornecedores()
    {
        if (dadosNotaConfirmados) return;
        termoFornecedor = string.Empty;
        cadastroFornecedorAberto = false;
        erroNovoFornecedor = null;
        modalFornecedoresAberto = true;
    }

    private void SelecionarFornecedor(Fornecedores fornecedor)
    {
        if (dadosNotaConfirmados) return;
        compraAtual.CodFornecedor = fornecedor.CodFornecedor;
        fornecedorSelecionado = fornecedor;
        modalFornecedoresAberto = false;

        if (fornecedor.CodCondicaoPagamento != null)
        {
            compraAtual.CodCondicaoPagamento = fornecedor.CodCondicaoPagamento;
            condicaoSelecionada = listaCondicoes.FirstOrDefault(c => c.CodCondicao == fornecedor.CodCondicaoPagamento);
        }
    }

    private void AbrirConsultaTransportadores()
    {
        termoTransportador = string.Empty;
        cadastroTransportadorAberto = false;
        erroNovoTransportador = null;
        modalTransportadoresAberto = true;
    }

    private void SelecionarTransportador(Transportadores transportador)
    {
        compraAtual.CodTransportador = transportador.CodTransportador;
        transportadorSelecionado = transportador;
        modalTransportadoresAberto = false;
    }

    private void LimparTransportador()
    {
        compraAtual.CodTransportador = null;
        transportadorSelecionado = null;
    }

    private void AbrirConsultaFormas()
    {
        cadastroFormaAberto = false;
        erroNovaForma = null;
        modalFormasAberto = true;
    }

    private void SelecionarForma(FormasPagamento forma)
    {
        compraAtual.CodFormaPagamento = forma.CodFormaPagamento;
        formaSelecionada = forma;
        modalFormasAberto = false;
    }

    // ---------- Itens ----------
    private void Recalcular() => ComprasCalculos.RatearCustos(compraAtual);

    private void AlterouItem(ComprasItens item)
    {
        // Mantém o percentual de desconto quando muda quantidade ou preço
        if (item.DescontoPercentual > 0)
            ComprasCalculos.AplicarDescontoPercentual(item);
        Recalcular();
    }

    private void AlterouDescontoPercentual(ComprasItens item)
    {
        item.DescontoPercentual = Math.Clamp(item.DescontoPercentual, 0, 100);
        ComprasCalculos.AplicarDescontoPercentual(item);
        Recalcular();
    }

    private void AlterouDescontoValor(ComprasItens item)
    {
        item.DescontoValor = Math.Clamp(item.DescontoValor, 0, item.TotalBruto);
        ComprasCalculos.AplicarDescontoValor(item);
        Recalcular();
    }

    private void RemoverItem(ComprasItens item)
    {
        if (parcelasGeradas) return;
        compraAtual.Itens.Remove(item);
        Recalcular();
    }

    // ---------- Popup de produtos ----------
    private void AbrirConsultaProdutos()
    {
        if (parcelasGeradas) return;
        termoProduto = string.Empty;
        produtoDetalhe = null;
        cadastroProdutoAberto = false;
        erroProdutos = null;
        modalProdutosAberto = true;
    }

    private void FecharConsultaProdutos()
    {
        modalProdutosAberto = false;
        novoProduto = new Produtos();
    }

    private void AdicionarProduto(Produtos produto)
    {
        if (parcelasGeradas) return;

        if (compraAtual.Itens.Any(i => i.CodProduto == produto.CodProduto))
        {
            erroProdutos = "Este produto já está na nota. Altere a quantidade na linha existente.";
            return;
        }

        compraAtual.Itens.Add(new ComprasItens
        {
            CodProduto = produto.CodProduto,
            oProduto = produto,
            Quantidade = 1,
            PrecoUnitario = produto.PrecoCusto
        });

        Recalcular();
        FecharConsultaProdutos();
    }

    private async Task SalvarNovoProduto()
    {
        erroProdutos = null;
        if (string.IsNullOrWhiteSpace(novoProduto.Produto)) { erroProdutos = "Nome é obrigatório."; return; }
        if (novoProduto.CodCategoria == 0) { erroProdutos = "Selecione uma categoria."; return; }
        if (string.IsNullOrWhiteSpace(novoProduto.UnidadeMedida)) { erroProdutos = "Informe a unidade."; return; }
        if (novoProduto.PrecoVenda <= 0) { erroProdutos = "Preço de venda deve ser maior que zero."; return; }

        try
        {
            await produtosService.AddProdutoAsync(novoProduto);
            listaProdutos = await produtosService.GetProdutosAsync();
            produtoDetalhe = listaProdutos.FirstOrDefault(p => p.CodProduto == novoProduto.CodProduto);
            termoProduto = novoProduto.Produto;
            novoProduto = new Produtos();
            cadastroProdutoAberto = false;
        }
        catch (Exception ex) { erroProdutos = ex.InnerException?.Message ?? ex.Message; }
    }

    // ---------- Popup de condições ----------
    private void AbrirConsultaCondicoes()
    {
        if (parcelasGeradas) return;
        cadastroCondicaoAberto = false;
        erroNovaCondicao = null;
        modalCondicoesAberto = true;
    }

    private void SelecionarCondicao(CondicaoPagamento condicao)
    {
        compraAtual.CodCondicaoPagamento = condicao.CodCondicao;
        condicaoSelecionada = condicao;
        modalCondicoesAberto = false;
    }

    private void AdicionarParcelaNovaCondicao()
    {
        novaCondicao.Parcelas.Add(new CondicaoPagamentoParcela { Numero = novaCondicao.Parcelas.Count + 1 });
        novaCondicao.NumeroParcelas = novaCondicao.Parcelas.Count;
    }

    private void RemoverParcelaNovaCondicao(CondicaoPagamentoParcela p)
    {
        novaCondicao.Parcelas.Remove(p);
        for (int i = 0; i < novaCondicao.Parcelas.Count; i++)
            novaCondicao.Parcelas[i].Numero = i + 1;
        novaCondicao.NumeroParcelas = novaCondicao.Parcelas.Count;
    }

    private async Task SalvarNovaCondicao()
    {
        erroNovaCondicao = null;
        if (string.IsNullOrWhiteSpace(novaCondicao.Descricao)) { erroNovaCondicao = "Descrição é obrigatória."; return; }

        try
        {
            await condicaoPagamentoService.AddCondicaoAsync(novaCondicao);
            listaCondicoes = (await condicaoPagamentoService.GetCondicoesPagamentoAsync()).Where(c => c.Ativo).ToList();
            var criada = listaCondicoes.FirstOrDefault(c => c.CodCondicao == novaCondicao.CodCondicao);
            novaCondicao = new CondicaoPagamento();
            cadastroCondicaoAberto = false;
            if (criada != null) SelecionarCondicao(criada);
        }
        catch (Exception ex) { erroNovaCondicao = ex.InnerException?.Message ?? ex.Message; }
    }

    // ---------- Parcelas ----------
    private void GerarParcelas()
    {
        mensagemErroModal = null;

        if (!compraAtual.Itens.Any()) { mensagemErroModal = "Adicione ao menos um produto."; return; }
        if (compraAtual.Itens.Any(i => i.Quantidade <= 0 || i.PrecoUnitario <= 0))
        { mensagemErroModal = "Todos os itens precisam de quantidade e valor unitário maiores que zero."; return; }
        if (condicaoSelecionada == null) { mensagemErroModal = "Selecione a condição de pagamento."; return; }
        if (compraAtual.DataEmissao.Date > DateTime.Today)
        { mensagemErroModal = "Data de emissão não pode ser posterior a hoje."; return; }

        Recalcular();
        compraAtual.Parcelas = ComprasCalculos.GerarParcelas(compraAtual, condicaoSelecionada);
    }

    private void RefazerParcelas()
    {
        compraAtual.Parcelas.Clear();
    }

    // ---------- Cadastros rápidos ----------
    private async Task SalvarNovoFornecedor()
    {
        erroNovoFornecedor = null;
        if (string.IsNullOrWhiteSpace(novoFornecedor.RazaoSocial)) { erroNovoFornecedor = "Razão social é obrigatória."; return; }
        if (string.IsNullOrWhiteSpace(novoFornecedor.CNPJ)) { erroNovoFornecedor = "CNPJ é obrigatório."; return; }
        if (novoFornecedor.CodCidade == 0) { erroNovoFornecedor = "Selecione uma cidade."; return; }

        try
        {
            await fornecedoresService.AddFornecedorAsync(novoFornecedor);
            listaFornecedores = await fornecedoresService.GetFornecedoresAsync();
            var criado = listaFornecedores.FirstOrDefault(f => f.CodFornecedor == novoFornecedor.CodFornecedor);
            novoFornecedor = new Fornecedores();
            cadastroFornecedorAberto = false;
            if (criado != null) SelecionarFornecedor(criado);
        }
        catch (Exception ex) { erroNovoFornecedor = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task SalvarNovoTransportador()
    {
        erroNovoTransportador = null;
        if (string.IsNullOrWhiteSpace(novoTransportador.Nome)) { erroNovoTransportador = "Nome é obrigatório."; return; }
        if (string.IsNullOrWhiteSpace(novoTransportador.CPF) && string.IsNullOrWhiteSpace(novoTransportador.CNPJ))
        { erroNovoTransportador = "Informe CPF ou CNPJ."; return; }
        if (novoTransportador.CodCidade == 0) { erroNovoTransportador = "Selecione uma cidade."; return; }

        try
        {
            await transportadoresService.AddTransportadorAsync(novoTransportador);
            listaTransportadores = await transportadoresService.GetTransportadoresAsync();
            var criado = listaTransportadores.FirstOrDefault(t => t.CodTransportador == novoTransportador.CodTransportador);
            novoTransportador = new Transportadores();
            cadastroTransportadorAberto = false;
            if (criado != null) SelecionarTransportador(criado);
        }
        catch (Exception ex) { erroNovoTransportador = ex.InnerException?.Message ?? ex.Message; }
    }

    private async Task SalvarNovaForma()
    {
        erroNovaForma = null;
        if (string.IsNullOrWhiteSpace(novaForma.FormaPagamento)) { erroNovaForma = "Descrição é obrigatória."; return; }

        try
        {
            await formasPagamentoService.AddFormaPagamentoAsync(novaForma);
            listaFormas = (await formasPagamentoService.GetFormasPagamentoAsync()).Where(f => f.Ativo).ToList();
            var criada = listaFormas.FirstOrDefault(f => f.CodFormaPagamento == novaForma.CodFormaPagamento);
            novaForma = new FormasPagamento();
            cadastroFormaAberto = false;
            if (criada != null) SelecionarForma(criada);
        }
        catch (Exception ex) { erroNovaForma = ex.InnerException?.Message ?? ex.Message; }
    }

    // ---------- Salvar / excluir ----------
    private async Task Salvar()
    {
        LimparMensagens();
        mensagemErroModal = null;

        if (!dadosNotaConfirmados) { mensagemErroModal = "Confirme os dados da nota antes de salvar."; return; }
        if (!parcelasGeradas) { mensagemErroModal = "Gere as parcelas antes de salvar."; return; }

        try
        {
            await comprasService.AddCompraAsync(compraAtual);
            mensagemSucesso = "Compra salva com sucesso. Estoque e custo dos produtos atualizados.";
            FecharModalForm();
            listaProdutos = await produtosService.GetProdutosAsync();
            await CarregarCompras();
        }
        catch (Exception ex)
        {
            mensagemErroModal = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private void AbrirModalExcluir(Compras c)
    {
        compraExcluir = c;
        modalExcluirAberto = true;
    }

    private void FecharModalExcluir()
    {
        modalExcluirAberto = false;
        compraExcluir = null;
    }

    private async Task ConfirmarExclusao()
    {
        if (compraExcluir == null) return;
        LimparMensagens();
        try
        {
            await comprasService.DeleteCompraAsync(
                compraExcluir.Modelo, compraExcluir.Serie, compraExcluir.NumeroNota, compraExcluir.CodFornecedor);
            mensagemSucesso = "Compra excluída. Estoque revertido.";
            FecharModalExcluir();
            await CarregarCompras();
        }
        catch (Exception ex)
        {
            mensagemErro = ex.InnerException?.Message ?? ex.Message;
            FecharModalExcluir();
        }
    }

    private void LimparMensagens()
    {
        mensagemErro = null;
        mensagemSucesso = null;
    }

    private static string FormatarCnpj(string? cnpj)
    {
        if (string.IsNullOrWhiteSpace(cnpj) || cnpj.Length != 14) return cnpj ?? string.Empty;
        return Convert.ToUInt64(cnpj).ToString(@"00\.000\.000\/0000\-00");
    }
}
