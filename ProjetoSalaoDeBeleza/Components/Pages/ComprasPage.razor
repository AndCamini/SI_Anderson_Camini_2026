@page "/compras"
@rendermode InteractiveServer
@using ProjetoSalaoDeBeleza.Models
@using ProjetoSalaoDeBeleza.Services
@inject ComprasService comprasService
@inject FornecedoresService fornecedoresService
@inject TransportadoresService transportadoresService
@inject ProdutosService produtosService
@inject CondicaoPagamentoService condicaoPagamentoService
@inject FormasPagamentoService formasPagamentoService
@inject CategoriasService categoriasService

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Compras</h3>
    <button class="btn btn-primary" @onclick="AbrirModalNovo">
        <i class="bi bi-plus-lg me-1"></i> Nova compra
    </button>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger alert-dismissible">
        @mensagemErro
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Cód</th>
                    <th>Nota</th>
                    <th>Fornecedor</th>
                    <th>Emissão</th>
                    <th>Chegada</th>
                    <th>Transportadora</th>
                    <th class="text-end">Total</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!listaCompras.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Nenhuma compra cadastrada.</td>
                    </tr>
                }
                @foreach (var c in listaCompras)
                {
                    <tr>
                        <td>@c.CodCompra</td>
                        <td><span class="badge bg-secondary">@c.Modelo/@c.Serie/@c.NumeroNota</span></td>
                        <td>@c.oFornecedor?.RazaoSocial</td>
                        <td>@c.DataEmissao.ToString("dd/MM/yyyy")</td>
                        <td>@c.DataChegada.ToString("dd/MM/yyyy")</td>
                        <td>@(c.oTransportador?.Nome ?? "—")</td>
                        <td class="text-end fw-semibold">
                            @((c.Itens.Sum(i => i.Quantidade * i.PrecoUnitario - i.Desconto) + c.Frete + c.Seguro + c.OutrasDespesas).ToString("C2"))
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => AbrirModalExcluir(c)">Excluir</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Modal Nova Compra *@
@if (modalFormAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.6)">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-cart-plus me-2"></i>Nova Nota de Entrada</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalForm"></button>
                </div>
                <div class="modal-body bg-light">

                    @if (!string.IsNullOrEmpty(mensagemErroModal))
                    {
                        <div class="alert alert-danger">@mensagemErroModal</div>
                    }

                    
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold">Dados da nota</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Modelo</label>
                                    <input class="form-control" @bind="compraAtual.Modelo" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Série</label>
                                    <input class="form-control" @bind="compraAtual.Serie" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Número</label>
                                    <input class="form-control" type="number" @bind="compraAtual.NumeroNota" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Fornecedor</label>
                                    <div class="input-group">
                                        <InputSelect @bind-Value="compraAtual.CodFornecedor" class="form-select">
                                            <option value="0">Selecione...</option>
                                            @foreach (var f in listaFornecedores)
                                            {
                                                <option value="@f.CodFornecedor">@f.RazaoSocial</option>
                                            }
                                        </InputSelect>
                                        <button type="button" class="btn btn-outline-secondary"
                                                @onclick="() => modalNovoFornecedorAberto = true">
                                            + Novo
                                        </button>
                                    </div>
                                </div>

                                @if (modalNovoFornecedorAberto)
                                {
                                    <div class="card border-primary mt-2 mb-1">
                                        <div class="card-header bg-primary text-white d-flex justify-content-between">
                                            <span>Novo Fornecedor</span>
                                            <button type="button" class="btn-close btn-close-white btn-sm"
                                                    @onclick="() => { modalNovoFornecedorAberto = false; novoFornecedor = new(); erroNovoFornecedor = null; }"></button>
                                        </div>
                                        <div class="card-body">
                                            @if (!string.IsNullOrEmpty(erroNovoFornecedor))
                                            {
                                                <div class="alert alert-danger py-1">@erroNovoFornecedor</div>
                                            }
                                            <div class="row g-2">
                                                <div class="col-md-6">
                                                    <label class="form-label">Razão Social</label>
                                                    <InputText @bind-Value="novoFornecedor.RazaoSocial" class="form-control form-control-sm" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label">CNPJ</label>
                                                    <InputText @bind-Value="novoFornecedor.CNPJ" class="form-control form-control-sm" maxlength="14" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label">Telefone</label>
                                                    <InputText @bind-Value="novoFornecedor.Telefone" class="form-control form-control-sm" maxlength="15" />
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="SalvarNovoFornecedor">Salvar</button>
                                        </div>
                                    </div>
                                }
                                <div class="col-6 col-md-3">
                                    <label class="form-label">Data de emissão</label>
                                    <InputDate @bind-Value="compraAtual.DataEmissao" class="form-control" />
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label">Data de chegada</label>
                                    <InputDate @bind-Value="compraAtual.DataChegada" class="form-control" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label">Transportadora</label>
                                    <div class="input-group">
                                        <InputSelect @bind-Value="compraAtual.CodTransportador" class="form-select">
                                            <option value="">Sem transportadora</option>
                                            @foreach (var t in listaTransportadores)
                                            {
                                                <option value="@t.CodTransportador">@t.Nome</option>
                                            }
                                        </InputSelect>
                                        <button type="button" class="btn btn-outline-secondary"
                                                @onclick="() => modalNovoTransportadorAberto = true">
                                            + Novo
                                        </button>
                                    </div>
                                </div>

                                @if (modalNovoTransportadorAberto)
                                {
                                    <div class="card border-primary mt-2 mb-1">
                                        <div class="card-header bg-primary text-white d-flex justify-content-between">
                                            <span>Novo Transportador</span>
                                            <button type="button" class="btn-close btn-close-white btn-sm"
                                                    @onclick="() => { modalNovoTransportadorAberto = false; novoTransportador = new(); erroNovoTransportador = null; }"></button>
                                        </div>
                                        <div class="card-body">
                                            @if (!string.IsNullOrEmpty(erroNovoTransportador))
                                            {
                                                <div class="alert alert-danger py-1">@erroNovoTransportador</div>
                                            }
                                            <div class="row g-2">
                                                <div class="col-md-5">
                                                    <label class="form-label">Nome</label>
                                                    <InputText @bind-Value="novoTransportador.Nome" class="form-control form-control-sm" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label">CPF</label>
                                                    <InputText @bind-Value="novoTransportador.CPF" class="form-control form-control-sm" maxlength="11" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">CNPJ</label>
                                                    <InputText @bind-Value="novoTransportador.CNPJ" class="form-control form-control-sm" maxlength="14" />
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="SalvarNovoTransportador">Salvar</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Produtos</span>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => modalNovoProdutoAberto = !modalNovoProdutoAberto">
                                    + Novo produto
                                </button>
                                <button type="button" class="btn btn-sm btn-primary" @onclick="AdicionarItem">
                                    <i class="bi bi-plus-lg me-1"></i>Adicionar à nota
                                </button>
                            </div>
                        </div>

                        @* Mini-modal abaixo do cabeçalho, antes da tabela *@
                        @if (modalNovoProdutoAberto)
                        {
                            <div class="card border-primary m-3">
                                <div class="card-header bg-primary text-white d-flex justify-content-between">
                                    <span>Novo Produto</span>
                                    <button type="button" class="btn-close btn-close-white btn-sm"
                                            @onclick="() => { modalNovoProdutoAberto = false; novoProduto = new(); erroNovoProduto = null; }"></button>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(erroNovoProduto))
                                    {
                                        <div class="alert alert-danger py-1">@erroNovoProduto</div>
                                    }
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label">Nome</label>
                                            <InputText @bind-Value="novoProduto.Produto" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Categoria</label>
                                            <InputSelect @bind-Value="novoProduto.CodCategoria" class="form-select form-select-sm">
                                                <option value="0">Selecione...</option>
                                                @foreach (var cat in listaCategorias)
                                                {
                                                    <option value="@cat.CodCategoria">@cat.Categoria</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Preço de venda</label>
                                            <InputNumber @bind-Value="novoProduto.PrecoVenda" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Unidade</label>
                                            <InputText @bind-Value="novoProduto.UnidadeMedida" class="form-control form-control-sm" maxlength="10" />
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="SalvarNovoProduto">Salvar</button>
                                </div>
                            </div>
                        }
                        <div class="card-body p-0">
                            @if (!compraAtual.Itens.Any())
                            {
                                <div class="text-center text-muted py-4">Nenhum produto adicionado.</div>
                            }
                            else
                            {
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:38%">Produto</th>
                                            <th style="width:12%">Quantidade</th>
                                            <th style="width:16%">Preço unitário</th>
                                            <th style="width:16%">Desconto</th>
                                            <th style="width:14%" class="text-end">Total</th>
                                            <th style="width:4%"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in compraAtual.Itens)
                                        {
                                            <tr>
                                                <td>
                                                    <InputSelect @bind-Value="item.CodProduto" class="form-select form-select-sm">
                                                        <option value="0">Selecione...</option>
                                                        @foreach (var p in listaProdutos)
                                                        {
                                                            <option value="@p.CodProduto">@p.Produto</option>
                                                        }
                                                    </InputSelect>
                                                </td>
                                                <td>
                                                    <InputNumber @bind-Value="item.Quantidade" class="form-control form-control-sm"
                                                                 @oninput="RecalcularTotais" />
                                                </td>
                                                <td>
                                                    <InputNumber @bind-Value="item.PrecoUnitario" class="form-control form-control-sm"
                                                                 @oninput="RecalcularTotais" />
                                                </td>
                                                <td>
                                                    <InputNumber @bind-Value="item.Desconto" class="form-control form-control-sm"
                                                                 @oninput="RecalcularTotais" />
                                                </td>
                                                <td class="text-end fw-semibold">
                                                    @(Math.Max(item.Quantidade * item.PrecoUnitario - item.Desconto, 0).ToString("C2"))
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-link text-danger p-0"
                                                            @onclick="() => RemoverItem(item)">
                                                        ✕
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>

                    <div class="row g-3">
                        
                        <div class="col-12 col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white fw-semibold">Custos e totais</div>
                                <div class="card-body">
                                    <div class="row g-3 mb-3">
                                        <div class="col-4">
                                            <label class="form-label">Frete</label>
                                            <InputNumber @bind-Value="compraAtual.Frete" class="form-control"
                                                         @oninput="RecalcularTotais" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label">Seguro</label>
                                            <InputNumber @bind-Value="compraAtual.Seguro" class="form-control"
                                                         @oninput="RecalcularTotais" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label">Outras despesas</label>
                                            <InputNumber @bind-Value="compraAtual.OutrasDespesas" class="form-control"
                                                         @oninput="RecalcularTotais" />
                                        </div>
                                    </div>
                                    <dl class="row mb-0">
                                        <dt class="col-7 fw-normal text-muted">Total dos produtos</dt>
                                        <dd class="col-5 text-end">@totalProdutos.ToString("C2")</dd>
                                        <dt class="col-7 fw-normal text-muted">Custos adicionais</dt>
                                        <dd class="col-5 text-end">@totalCustos.ToString("C2")</dd>
                                        <dt class="col-7 fw-semibold">Total da compra</dt>
                                        <dd class="col-5 text-end fw-bold fs-5 text-primary">@totalGeral.ToString("C2")</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        
                        <div class="col-12 col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-white fw-semibold">Pagamento</div>
                                <div class="card-body">
                                    <div class="row g-3 mb-3">
                                        <div class="col-7">
                                            <label class="form-label">Condição de pagamento</label>
                                            <div class="input-group">
                                                <InputSelect @bind-Value="compraAtual.CodCondicaoPagamento" class="form-select"
                                                             @onchange="GerarParcelas">
                                                    <option value="">Selecione...</option>
                                                    @foreach (var cp in listaCondicoes)
                                                    {
                                                        <option value="@cp.CodCondicao">@cp.Descricao</option>
                                                    }
                                                </InputSelect>
                                                <button type="button" class="btn btn-outline-secondary"
                                                        @onclick="() => modalNovaCondicaoAberto = true">
                                                    + Nova
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-5">
                                            <label class="form-label">Forma de pagamento</label>
                                            <div class="input-group">
                                                <InputSelect @bind-Value="compraAtual.CodFormaPagamento" class="form-select">
                                                    <option value="">Selecione...</option>
                                                    @foreach (var fp in listaFormas)
                                                    {
                                                        <option value="@fp.CodFormaPagamento">@fp.FormaPagamento</option>
                                                    }
                                                </InputSelect>
                                                <button type="button" class="btn btn-outline-secondary"
                                                        @onclick="() => modalNovaFormaAberto = true">
                                                    + Nova
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    @* Mini-modal Nova Condição *@
                                    @if (modalNovaCondicaoAberto)
                                    {
                                        <div class="card border-primary mb-3">
                                            <div class="card-header bg-primary text-white d-flex justify-content-between">
                                                <span>Nova Condição de Pagamento</span>
                                                <button type="button" class="btn-close btn-close-white btn-sm"
                                                        @onclick="() => { modalNovaCondicaoAberto = false; novaCondicao = new(); erroNovaCondicao = null; }"></button>
                                            </div>
                                            <div class="card-body">
                                                @if (!string.IsNullOrEmpty(erroNovaCondicao))
                                                {
                                                    <div class="alert alert-danger py-1">@erroNovaCondicao</div>
                                                }
                                                <div class="row g-2">
                                                    <div class="col-md-4">
                                                        <label class="form-label">Descrição</label>
                                                        <InputText @bind-Value="novaCondicao.Descricao" class="form-control form-control-sm" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">Nº Parcelas</label>
                                                        <InputNumber @bind-Value="novaCondicao.NumeroParcelas" class="form-control form-control-sm" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">1ª Parcela (dias)</label>
                                                        <InputNumber @bind-Value="novaCondicao.PrimeiraParcela" class="form-control form-control-sm" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">Juros (%)</label>
                                                        <InputNumber @bind-Value="novaCondicao.Juros" class="form-control form-control-sm" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">Desconto (%)</label>
                                                        <InputNumber @bind-Value="novaCondicao.Desconto" class="form-control form-control-sm" />
                                                    </div>
                                                </div>
                                                <hr class="my-2" />
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="fw-semibold small">Parcelas</span>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                                            @onclick="AdicionarParcelaNovaCondicao">
                                                        + Adicionar parcela
                                                    </button>
                                                </div>
                                                @{
                                                    var totalPct = novaCondicao.Parcelas.Sum(p => p.Percentual);
                                                    var pctClass = totalPct == 100 ? "text-success" : "text-danger";
                                                }
                                                @if (novaCondicao.Parcelas.Any())
                                                {
                                                    <table class="table table-sm mb-2">
                                                        <thead class="table-light">
                                                            <tr><th>Nº</th><th>Dias</th><th>%</th><th></th></tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var p in novaCondicao.Parcelas)
                                                            {
                                                                <tr>
                                                                    <td>@p.Numero</td>
                                                                    <td><InputNumber @bind-Value="p.Dias" class="form-control form-control-sm" /></td>
                                                                    <td><InputNumber @bind-Value="p.Percentual" class="form-control form-control-sm" /></td>
                                                                    <td>
                                                                        <button type="button" class="btn btn-link text-danger p-0"
                                                                                @onclick="() => RemoverParcelaNovaCondicao(p)">
                                                                            ✕
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                    <div class="text-end small @pctClass">Total: @totalPct.ToString("F2")%</div>
                                                }
                                                <button type="button" class="btn btn-primary btn-sm mt-2"
                                                        @onclick="SalvarNovaCondicao">
                                                    Salvar
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    @* Mini-modal Nova Forma *@
                                    @if (modalNovaFormaAberto)
                                    {
                                        <div class="card border-primary mb-3">
                                            <div class="card-header bg-primary text-white d-flex justify-content-between">
                                                <span>Nova Forma de Pagamento</span>
                                                <button type="button" class="btn-close btn-close-white btn-sm"
                                                        @onclick="() => { modalNovaFormaAberto = false; novaForma = new(); erroNovaForma = null; }"></button>
                                            </div>
                                            <div class="card-body">
                                                @if (!string.IsNullOrEmpty(erroNovaForma))
                                                {
                                                    <div class="alert alert-danger py-1">@erroNovaForma</div>
                                                }
                                                <div class="row g-2 align-items-end">
                                                    <div class="col-md-8">
                                                        <label class="form-label">Descrição</label>
                                                        <InputText @bind-Value="novaForma.FormaPagamento" class="form-control form-control-sm" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <button type="button" class="btn btn-primary btn-sm w-100"
                                                                @onclick="SalvarNovaForma">
                                                            Salvar
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    
                    <div class="card border-0 shadow-sm mt-3">
                        <div class="card-body">
                            <label class="form-label">Observações</label>
                            <InputTextArea @bind-Value="compraAtual.Observacoes" class="form-control" rows="2"
                                           placeholder="Anotações sobre a compra" />
                        </div>
                    </div>

                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-outline-secondary" @onclick="FecharModalForm">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Salvar">
                        <i class="bi bi-check-lg me-1"></i>Salvar compra
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Confirmação de Exclusão *@
@if (modalExcluirAberto && compraExcluir != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.6)">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalExcluir"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">Tem certeza que deseja excluir esta compra? O estoque dos produtos será revertido.</p>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr><th>Código</th><td>@compraExcluir.CodCompra</td></tr>
                            <tr><th>Nota</th><td>@compraExcluir.Modelo/@compraExcluir.Serie/@compraExcluir.NumeroNota</td></tr>
                            <tr><th>Fornecedor</th><td>@compraExcluir.oFornecedor?.RazaoSocial</td></tr>
                            <tr><th>Emissão</th><td>@compraExcluir.DataEmissao.ToString("dd/MM/yyyy")</td></tr>
                            <tr><th>Itens</th><td>@compraExcluir.Itens.Count produto(s)</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalExcluir">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusao">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Compras> listaCompras = new();
    private List<Fornecedores> listaFornecedores = new();
    private List<Transportadores> listaTransportadores = new();
    private List<Produtos> listaProdutos = new();
    private List<CondicaoPagamento> listaCondicoes = new();
    private List<FormasPagamento> listaFormas = new();
    private List<Categorias> listaCategorias = new();
    private Fornecedores novoFornecedor = new();
    private Transportadores novoTransportador = new();
    private Produtos novoProduto = new();
    private FormasPagamento novaForma = new();

    private Compras compraAtual = new();
    private Compras? compraExcluir;
    private bool modalFormAberto = false;
    private bool modalExcluirAberto = false;
    private bool modalNovoFornecedorAberto = false;
    private bool modalNovoTransportadorAberto = false;
    private bool modalNovoProdutoAberto = false;
    private bool modalNovaFormaAberto = false;
    private string? mensagemErro;
    private string? mensagemSucesso;
    private string? mensagemErroModal;
    private string? erroNovoFornecedor;
    private string? erroNovoTransportador;
    private string? erroNovoProduto;
    private string? erroNovaForma;

    private decimal totalProdutos = 0;
    private decimal totalCustos = 0;
    private decimal totalGeral = 0;

    protected override async Task OnInitializedAsync()
    {
        listaFornecedores = await fornecedoresService.GetFornecedoresAsync();
        listaTransportadores = await transportadoresService.GetTransportadoresAsync();
        listaProdutos = await produtosService.GetProdutosAsync();
        listaCondicoes = await condicaoPagamentoService.GetCondicoesPagamentoAsync();
        listaFormas = await formasPagamentoService.GetFormasPagamentoAsync();
        listaCategorias = await categoriasService.GetCategoriasAsync();
        await CarregarCompras();
    }

    private async Task CarregarCompras()
    {
        listaCompras = await comprasService.GetComprasAsync();
    }

    private void AbrirModalNovo()
    {
        compraAtual = new Compras
        {
            DataEmissao = DateTime.Today,
            DataChegada = DateTime.Today
        };
        totalProdutos = 0;
        totalCustos = 0;
        totalGeral = 0;
        mensagemErroModal = null;
        modalFormAberto = true;
    }

    private void FecharModalForm()
    {
        modalFormAberto = false;
        compraAtual = new Compras();
        mensagemErroModal = null;
    }

    private void AbrirModalExcluir(Compras c)
    {
        compraExcluir = c;
        modalExcluirAberto = true;
    }

    private void FecharModalExcluir()
    {
        modalExcluirAberto = false;
        compraExcluir = null;
    }

    private void AdicionarItem()
    {
        compraAtual.Itens.Add(new ComprasItens
        {
            CodProduto = 0,
            Quantidade = 1,
            PrecoUnitario = 0,
            Desconto = 0
        });
        RecalcularTotais();
    }

    private void RemoverItem(ComprasItens item)
    {
        compraAtual.Itens.Remove(item);
        RecalcularTotais();
    }

    private void RecalcularTotais()
    {
        totalProdutos = compraAtual.Itens
            .Sum(i => Math.Max(i.Quantidade * i.PrecoUnitario - i.Desconto, 0));
        totalCustos = compraAtual.Frete + compraAtual.Seguro + compraAtual.OutrasDespesas;
        totalGeral = totalProdutos + totalCustos;
        GerarParcelas();
    }

    private void GerarParcelas(ChangeEventArgs? args = null)
    {
        compraAtual.Parcelas.Clear();
        if (compraAtual.CodCondicaoPagamento == null || totalGeral == 0) return;

        var condicao = listaCondicoes
            .FirstOrDefault(c => c.CodCondicao == compraAtual.CodCondicaoPagamento);
        if (condicao == null) return;

        for (int i = 0; i < condicao.Parcelas.Count; i++)
        {
            var parcela = condicao.Parcelas[i];
            compraAtual.Parcelas.Add(new ComprasParcelas
            {
                Numero = i + 1,
                Vencimento = DateTime.Today.AddDays(parcela.Dias),
                Valor = Math.Round(totalGeral * (parcela.Percentual / 100), 2)
            });
        }
    }

    private async Task Salvar()
    {
        LimparMensagens();
        RecalcularTotais();

        if (compraAtual.DataEmissao.Date > DateTime.Today)
        {
            mensagemErroModal = "Data de emissão não pode ser posterior a hoje.";
            return;
        }
        if (compraAtual.DataChegada.Date < compraAtual.DataEmissao.Date)
        {
            mensagemErroModal = "Data de chegada não pode ser anterior à data de emissão.";
            return;
        }

        try
        {
            await comprasService.AddCompraAsync(compraAtual);
            mensagemSucesso = "Compra salva com sucesso. Estoque atualizado.";
            FecharModalForm();
            await CarregarCompras();
        }
        catch (Exception ex)
        {
            mensagemErroModal = ex.Message;
        }
    }

    private async Task ConfirmarExclusao()
    {
        if (compraExcluir == null) return;
        LimparMensagens();
        try
        {
            await comprasService.DeleteCompraAsync(compraExcluir.CodCompra);
            mensagemSucesso = "Compra excluída. Estoque revertido.";
            FecharModalExcluir();
            await CarregarCompras();
        }
        catch (Exception ex)
        {
            mensagemErro = ex.Message;
            FecharModalExcluir();
        }
    }

    private async Task SalvarNovoFornecedor()
    {
        erroNovoFornecedor = null;
        if (string.IsNullOrWhiteSpace(novoFornecedor.RazaoSocial))
        { erroNovoFornecedor = "Razão Social é obrigatória."; return; }
        if (string.IsNullOrWhiteSpace(novoFornecedor.CNPJ))
        { erroNovoFornecedor = "CNPJ é obrigatório."; return; }
        try
        {
            await fornecedoresService.AddFornecedorAsync(novoFornecedor);
            listaFornecedores = await fornecedoresService.GetFornecedoresAsync();
            compraAtual.CodFornecedor = listaFornecedores
                .First(f => f.CNPJ == novoFornecedor.CNPJ.ToUpper()).CodFornecedor;
            novoFornecedor = new Fornecedores();
            modalNovoFornecedorAberto = false;
        }
        catch (Exception ex) { erroNovoFornecedor = ex.Message; }
    }

    private async Task SalvarNovoTransportador()
    {
        erroNovoTransportador = null;
        if (string.IsNullOrWhiteSpace(novoTransportador.Nome))
        { erroNovoTransportador = "Nome é obrigatório."; return; }
        if (string.IsNullOrWhiteSpace(novoTransportador.CPF) && string.IsNullOrWhiteSpace(novoTransportador.CNPJ))
        { erroNovoTransportador = "Informe CPF ou CNPJ."; return; }
        try
        {
            await transportadoresService.AddTransportadorAsync(novoTransportador);
            listaTransportadores = await transportadoresService.GetTransportadoresAsync();
            compraAtual.CodTransportador = listaTransportadores
                .First(t => t.Nome == novoTransportador.Nome.ToUpper()).CodTransportador;
            novoTransportador = new Transportadores();
            modalNovoTransportadorAberto = false;
        }
        catch (Exception ex) { erroNovoTransportador = ex.Message; }
    }

    private async Task SalvarNovoProduto()
    {
        erroNovoProduto = null;
        if (string.IsNullOrWhiteSpace(novoProduto.Produto))
        { erroNovoProduto = "Nome é obrigatório."; return; }
        if (novoProduto.CodCategoria == 0)
        { erroNovoProduto = "Selecione uma categoria."; return; }
        if (novoProduto.PrecoVenda <= 0)
        { erroNovoProduto = "Preço de venda deve ser maior que zero."; return; }
        try
        {
            await produtosService.AddProdutoAsync(novoProduto);
            listaProdutos = await produtosService.GetProdutosAsync();
            novoProduto = new Produtos();
            modalNovoProdutoAberto = false;
        }
        catch (Exception ex) { erroNovoProduto = ex.Message; }
    }

    private async Task SalvarNovaForma()
    {
        erroNovaForma = null;
        if (string.IsNullOrWhiteSpace(novaForma.FormaPagamento))
        { erroNovaForma = "Descrição é obrigatória."; return; }
        try
        {
            await formasPagamentoService.AddFormaPagamentoAsync(novaForma);
            listaFormas = await formasPagamentoService.GetFormasPagamentoAsync();
            compraAtual.CodFormaPagamento = listaFormas
                .First(f => f.FormaPagamento == novaForma.FormaPagamento.ToUpper()).CodFormaPagamento;
            novaForma = new FormasPagamento();
            modalNovaFormaAberto = false;
        }
        catch (Exception ex) { erroNovaForma = ex.Message; }
    }

    private bool modalNovaCondicaoAberto = false;
    private CondicaoPagamento novaCondicao = new();
    private string? erroNovaCondicao;

    private void AdicionarParcelaNovaCondicao()
    {
        novaCondicao.Parcelas.Add(new CondicaoPagamentoParcela
        {
            Numero = novaCondicao.Parcelas.Count + 1,
            Dias = 0,
            Percentual = 0
        });
    }

    private void RemoverParcelaNovaCondicao(CondicaoPagamentoParcela p)
    {
        novaCondicao.Parcelas.Remove(p);
        for (int i = 0; i < novaCondicao.Parcelas.Count; i++)
            novaCondicao.Parcelas[i].Numero = i + 1;
    }

    private async Task SalvarNovaCondicao()
    {
        erroNovaCondicao = null;
        if (string.IsNullOrWhiteSpace(novaCondicao.Descricao))
        { erroNovaCondicao = "Descrição é obrigatória."; return; }
        try
        {
            await condicaoPagamentoService.AddCondicaoAsync(novaCondicao);
            listaCondicoes = await condicaoPagamentoService.GetCondicoesPagamentoAsync();
            compraAtual.CodCondicaoPagamento = listaCondicoes
                .First(c => c.Descricao == novaCondicao.Descricao.ToUpper()).CodCondicao;
            novaCondicao = new CondicaoPagamento();
            modalNovaCondicaoAberto = false;
            GerarParcelas();
        }
        catch (Exception ex) { erroNovaCondicao = ex.Message; }
    }

    private void LimparMensagens()
    {
        mensagemErro = null;
        mensagemSucesso = null;
    }
}