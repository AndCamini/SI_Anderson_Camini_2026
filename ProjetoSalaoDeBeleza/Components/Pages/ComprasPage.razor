                                    <td class="text-end">@c.Juros.ToString("N2")</td>
                                    <td class="text-end">@c.Desconto.ToString("N2")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelecionarCondicao(c)">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

