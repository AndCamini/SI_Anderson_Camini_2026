@page "/fornecedores"
@rendermode InteractiveServer
@using ProjetoSalaoDeBeleza.Models
@using ProjetoSalaoDeBeleza.Services
@inject FornecedoresService fornecedoresService
@inject CidadesService cidadesService
@inject EstadosService estadosService
@inject CondicaoPagamentoService condicaoPagamentoService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Fornecedores</h3>
    <button class="btn btn-primary" @onclick="AbrirModalNovo">+ Cadastrar novo</button>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger alert-dismissible">
        @mensagemErro
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Cód</th>
            <th>Razão Social</th>
            <th>Nome Fantasia</th>
            <th>CNPJ</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Cidade</th>
            <th>Ativo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in listaFornecedores)
        {
            <tr>
                <td>@f.CodFornecedor</td>
                <td>@f.RazaoSocial</td>
                <td>@f.NomeFantasia</td>
                <td>@f.CNPJ</td>
                <td>@f.Email</td>
                <td>@f.Telefone</td>
                <td>@f.oCidade?.Cidade</td>
                <td>@(f.Ativo ? "Sim" : "Não")</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalEditar(f)">Editar</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => AbrirModalExcluir(f)">Excluir</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Modal Cadastro/Edição *@
@if (modalFormAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(fornecedorAtual.CodFornecedor == 0 ? "Novo Fornecedor" : "Editar Fornecedor")</h5>
                    <button type="button" class="btn-close" @onclick="FecharModalForm"></button>
                </div>
                <EditForm Model="@fornecedorAtual" OnValidSubmit="Salvar" FormName="formFornecedores">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensagemErroModal))
                        {
                            <div class="alert alert-danger">@mensagemErroModal</div>
                        }
                        <div class="row g-3">
                            <div class="col-auto">
                                <label class="form-label d-block">Status</label>
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox @bind-Value="fornecedorAtual.Ativo" class="form-check-input" role="switch" id="ativoCheckForn" />
                                    <label class="form-check-label @(fornecedorAtual.Ativo ? "text-success" : "text-muted")" for="ativoCheckForn">@(fornecedorAtual.Ativo ? "Ativo" : "Inativo")</label>
                                </div>
                            </div>
                            <div class="w-100 mt-0"></div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Razão Social <span class="text-danger">*</span></label>
                                <InputText @bind-Value="fornecedorAtual.RazaoSocial" class="form-control" placeholder="Digite a razão social" />
                                <ValidationMessage For="@(() => fornecedorAtual.RazaoSocial)" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Nome Fantasia</label>
                                <InputText @bind-Value="fornecedorAtual.NomeFantasia" class="form-control" placeholder="Nome fantasia" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">CNPJ <span class="text-danger">*</span></label>
                                <InputText @bind-Value="fornecedorAtual.CNPJ" class="form-control" maxlength="14" placeholder="Somente números" />
                                <ValidationMessage For="@(() => fornecedorAtual.CNPJ)" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Inscrição Estadual</label>
                                <InputText @bind-Value="fornecedorAtual.InscricaoEstadual" class="form-control" maxlength="20" placeholder="Número da I.E." />
                            </div>
                            <div class="col-4 col-md-2">
                                <label class="form-label">CEP</label>
                                <InputText @bind-Value="fornecedorAtual.CEP" class="form-control" maxlength="8" placeholder="Somente números" />
                            </div>
                            <div class="col-8 col-md-8">
                                <label class="form-label">Logradouro</label>
                                <InputText @bind-Value="fornecedorAtual.Rua" class="form-control" placeholder="Rua, avenida, alameda..." />
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label">Número</label>
                                <InputText @bind-Value="fornecedorAtual.Numero" class="form-control" maxlength="10" placeholder="Nº" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">Cidade <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input class="form-control" readonly value="@CidadeSelecionadaTexto" placeholder="Selecionar cidade..." />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="AbrirConsultaCidades">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="w-100 mt-0"></div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Complemento</label>
                                <InputText @bind-Value="fornecedorAtual.Complemento" class="form-control" placeholder="Apto, bloco, sala..." />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Bairro</label>
                                <InputText @bind-Value="fornecedorAtual.Bairro" class="form-control" placeholder="Bairro" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">Condição de Pagamento</label>
                                <InputSelect @bind-Value="fornecedorAtual.CodCondicaoPagamento" class="form-select">
                                    <option value="">Selecionar...</option>
                                    @foreach (var cp in listaCondicoes)
                                    {
                                        <option value="@cp.CodCondicao">@cp.Descricao</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="w-100 mt-0"></div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">E-mail</label>
                                <InputText @bind-Value="fornecedorAtual.Email" class="form-control" placeholder="email@exemplo.com" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Telefone</label>
                                <InputText @bind-Value="fornecedorAtual.Telefone" class="form-control" maxlength="15" placeholder="(00) 00000-0000" />
                            </div>
                        </div>
                        @if (fornecedorAtual.CodFornecedor != 0)
                        {
                            <hr class="my-3" />
                            <div class="row g-3 text-muted small">
                                <div class="col-md-4">
                                    <label class="form-label">Cadastrado em</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@fornecedorAtual.DataCadastro.ToString("dd/MM/yyyy HH:mm")" disabled />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Última Alteração</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@(fornecedorAtual.DataUltimaAlteracao?.ToString("dd/MM/yyyy HH:mm") ?? "—")" disabled />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Alterado por</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@(fornecedorAtual.UsuarioUltimaAlteracao ?? "—")" disabled />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-dark px-4">Salvar</button>
                        <button type="button" class="btn btn-link text-secondary text-decoration-none" @onclick="FecharModalForm">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (modalCidadesAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5); z-index:1060">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-geo-alt me-2"></i>Cidades</h5>
                    <button type="button" class="btn-close" @onclick="() => modalCidadesAberto = false"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-2 mb-3">
                        <input class="form-control" placeholder="Buscar por código, cidade ou UF"
                               @bind="termoCidade" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap"
                                @onclick="() => { cadastroCidadeAberto = !cadastroCidadeAberto; erroNovaCidade = null; }">
                            + Nova cidade
                        </button>
                    </div>

                    @if (cadastroCidadeAberto)
                    {
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white">Nova cidade</div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(erroNovaCidade))
                                {
                                    <div class="alert alert-danger py-1">@erroNovaCidade</div>
                                }
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <label class="form-label">Nome</label>
                                        <InputText @bind-Value="novaCidade.Cidade" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label">Estado</label>
                                        <InputSelect @bind-Value="novaCidade.CodEstado" class="form-select form-select-sm">
                                            <option value="0">Selecione...</option>
                                            @foreach (var estado in listaEstados)
                                            {
                                                <option value="@estado.CodEstado">@estado.Estado - @estado.UF</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">DDD</label>
                                        <InputNumber @bind-Value="novaCidade.DDD" class="form-control form-control-sm text-end" />
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="SalvarNovaCidade">Salvar</button>
                            </div>
                        </div>
                    }

                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cód.</th>
                                <th>Cidade</th>
                                <th>UF</th>
                                <th class="text-end">DDD</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!CidadesFiltradas.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">Nenhuma cidade encontrada.</td></tr>
                            }
                            @foreach (var c in CidadesFiltradas)
                            {
                                <tr class="@(fornecedorAtual.CodCidade == c.CodCidade ? "table-primary" : "")">
                                    <td>@c.CodCidade</td>
                                    <td>@c.Cidade</td>
                                    <td>@c.oEstado?.UF</td>
                                    <td class="text-end">@c.DDD</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelecionarCidade(c)">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Confirmação de Exclusão *@
@if (modalExcluirAberto && fornecedorExcluir != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalExcluir"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">Tem certeza que deseja excluir este fornecedor? Esta ação não pode ser desfeita.</p>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr><th>Código</th><td>@fornecedorExcluir.CodFornecedor</td></tr>
                            <tr><th>Razão Social</th><td>@fornecedorExcluir.RazaoSocial</td></tr>
                            <tr><th>Nome Fantasia</th><td>@fornecedorExcluir.NomeFantasia</td></tr>
                            <tr><th>CNPJ</th><td>@fornecedorExcluir.CNPJ</td></tr>
                            <tr><th>Inscrição Estadual</th><td>@fornecedorExcluir.InscricaoEstadual</td></tr>
                            <tr><th>Email</th><td>@fornecedorExcluir.Email</td></tr>
                            <tr><th>Telefone</th><td>@fornecedorExcluir.Telefone</td></tr>
                            <tr><th>Cidade</th><td>@fornecedorExcluir.oCidade?.Cidade</td></tr>
                            <tr><th>Ativo</th><td>@(fornecedorExcluir.Ativo ? "Sim" : "Não")</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalExcluir">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusao">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Fornecedores> listaFornecedores = new();
    private List<Cidades> listaCidades = new();
    private List<CondicaoPagamento> listaCondicoes = new();
    private Fornecedores fornecedorAtual = new();
    private Fornecedores? fornecedorExcluir;
    private bool modalFormAberto = false;
    private bool modalExcluirAberto = false;
    private string? mensagemErro;
    private string? mensagemSucesso;
    private string? mensagemErroModal;
    private List<Estados> listaEstados = new();
    private Cidades novaCidade = new();
    private bool modalCidadesAberto;
    private bool cadastroCidadeAberto;
    private string termoCidade = string.Empty;
    private string? erroNovaCidade;

    private IEnumerable<Cidades> CidadesFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(termoCidade)) return listaCidades;

            var termo = termoCidade.Trim().ToUpper();
            return listaCidades.Where(c =>
                c.CodCidade.ToString() == termo ||
                (c.Cidade ?? "").ToUpper().Contains(termo) ||
                (c.oEstado?.UF ?? "").ToUpper() == termo);
        }
    }

    private string CidadeSelecionadaTexto
    {
        get
        {
            var cidade = listaCidades.FirstOrDefault(c => c.CodCidade == fornecedorAtual.CodCidade);
            return cidade == null ? "" : $"{cidade.CodCidade} - {cidade.Cidade} - {cidade.oEstado?.UF}";
        }
    }

    private void AbrirConsultaCidades()
    {
        termoCidade = string.Empty;
        cadastroCidadeAberto = false;
        erroNovaCidade = null;
        modalCidadesAberto = true;
    }

    private void SelecionarCidade(Cidades cidade)
    {
        fornecedorAtual.CodCidade = cidade.CodCidade;
        modalCidadesAberto = false;
    }

    protected override async Task OnInitializedAsync()
    {
        listaCidades = await cidadesService.GetCidadesAsync();
        listaEstados = await estadosService.GetEstadosAsync();
        listaCondicoes = (await condicaoPagamentoService.GetCondicoesPagamentoAsync()).Where(c => c.Ativo).ToList();
        await CarregarFornecedores();
    }

    private async Task CarregarFornecedores()
    {
        listaFornecedores = await fornecedoresService.GetFornecedoresAsync();
    }

    private void AbrirModalNovo()
    {
        fornecedorAtual = new Fornecedores();
        mensagemErroModal = null;
        modalFormAberto = true;
    }

    private void AbrirModalEditar(Fornecedores f)
    {
        fornecedorAtual = new Fornecedores
        {
            CodFornecedor = f.CodFornecedor,
            RazaoSocial = f.RazaoSocial,
            NomeFantasia = f.NomeFantasia,
            CNPJ = f.CNPJ,
            InscricaoEstadual = f.InscricaoEstadual,
            Email = f.Email,
            Telefone = f.Telefone,
            CEP = f.CEP,
            Rua = f.Rua,
            Numero = f.Numero,
            Complemento = f.Complemento,
            Bairro = f.Bairro,
            CodCidade = f.CodCidade,
            CodCondicaoPagamento = f.CodCondicaoPagamento,
            DataCadastro = f.DataCadastro,
            DataUltimaAlteracao = f.DataUltimaAlteracao,
            UsuarioUltimaAlteracao = f.UsuarioUltimaAlteracao,
            Ativo = f.Ativo
        };
        mensagemErroModal = null;
        modalFormAberto = true;
    }

    private void FecharModalForm()
    {
        modalFormAberto = false;
        fornecedorAtual = new Fornecedores();
        mensagemErroModal = null;
    }

    private void AbrirModalExcluir(Fornecedores f)
    {
        fornecedorExcluir = f;
        modalExcluirAberto = true;
    }

    private void FecharModalExcluir()
    {
        modalExcluirAberto = false;
        fornecedorExcluir = null;
    }

    private async Task Salvar()
    {
        LimparMensagens();
        try
        {
            if (fornecedorAtual.CodFornecedor == 0)
                await fornecedoresService.AddFornecedorAsync(fornecedorAtual);
            else
                await fornecedoresService.UpdateFornecedorAsync(fornecedorAtual);

            mensagemSucesso = "Fornecedor salvo com sucesso.";
            FecharModalForm();
            await CarregarFornecedores();
        }
        catch (Exception ex)
        {
            mensagemErroModal = ex.Message;
        }
    }

    private async Task SalvarNovaCidade()
    {
        erroNovaCidade = null;
        if (string.IsNullOrWhiteSpace(novaCidade.Cidade))
        {
            erroNovaCidade = "Nome é obrigatório.";
            return;
        }
        if (novaCidade.CodEstado == 0)
        {
            erroNovaCidade = "Selecione um estado.";
            return;
        }
        try
        {
            await cidadesService.AddCidadeAsync(novaCidade);
            listaCidades = await cidadesService.GetCidadesAsync();
            var criada = listaCidades.FirstOrDefault(c => c.Cidade == novaCidade.Cidade.ToUpper() && c.CodEstado == novaCidade.CodEstado);
            novaCidade = new Cidades();
            cadastroCidadeAberto = false;
            if (criada != null) SelecionarCidade(criada);
        }
        catch (Exception ex)
        {
            erroNovaCidade = ex.Message;
        }
    }

    private async Task ConfirmarExclusao()
    {
        if (fornecedorExcluir == null) return;
        LimparMensagens();
        try
        {
            await fornecedoresService.DeleteFornecedorAsync(fornecedorExcluir.CodFornecedor);
            mensagemSucesso = "Fornecedor excluído com sucesso.";
            FecharModalExcluir();
            await CarregarFornecedores();
        }
        catch (Exception ex)
        {
            mensagemErro = ex.Message;
            FecharModalExcluir();
        }
    }

    private void LimparMensagens()
    {
        mensagemErro = null;
        mensagemSucesso = null;
    }
}