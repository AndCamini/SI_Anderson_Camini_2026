@page "/veiculos"
@rendermode InteractiveServer
@using ProjetoSalaoDeBeleza.Models
@using ProjetoSalaoDeBeleza.Services
@inject VeiculosService veiculosService
@inject MarcasVeiculosService marcasService
@inject TiposVeiculoService tiposService
@inject TransportadoresService transportadoresService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Veículos</h3>
    <button class="btn btn-primary" @onclick="AbrirModalNovo">+ Cadastrar novo</button>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger alert-dismissible">
        @mensagemErro
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Cód</th>
            <th>Placa</th>
            <th>Mercosul</th>
            <th>Modelo</th>
            <th>Marca</th>
            <th>Tipo</th>
            <th>Cor</th>
            <th>Ano</th>
            <th>Transportador</th>
            <th>Ativo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in listaVeiculos)
        {
            <tr>
                <td>@v.CodVeiculo</td>
                <td>@v.Placa</td>
                <td>@(v.PlacaMercosul ? "Sim" : "Não")</td>
                <td>@v.Modelo</td>
                <td>@v.oMarca?.MarcaVeiculo</td>
                <td>@v.oTipo?.Tipo</td>
                <td>@v.Cor</td>
                <td>@v.Ano</td>
                <td>@v.oTransportador?.Nome</td>
                <td>@(v.Ativo ? "Sim" : "Não")</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalEditar(v)">Editar</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => AbrirModalExcluir(v)">Excluir</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Modal Cadastro/Edição *@
@if (modalFormAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(veiculoAtual.CodVeiculo == 0 ? "Novo Veículo" : "Editar Veículo")</h5>
                    <button type="button" class="btn-close" @onclick="FecharModalForm"></button>
                </div>
                <EditForm Model="@veiculoAtual" OnValidSubmit="Salvar" FormName="formVeiculos">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensagemErroModal))
                        {
                            <div class="alert alert-danger">@mensagemErroModal</div>
                        }

                        <div class="row align-items-end mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Placa</label>
                                <InputText @bind-Value="veiculoAtual.Placa" class="form-control text-uppercase" maxlength="7" />
                                <ValidationMessage For="@(() => veiculoAtual.Placa)" />
                            </div>
                            <div class="col-md-4 form-check ms-3 mt-4">
                                <InputCheckbox @bind-Value="veiculoAtual.PlacaMercosul" class="form-check-input" id="mercosulCheck" />
                                <label class="form-check-label" for="mercosulCheck">Placa Mercosul</label>
                            </div>
                        </div>
                        @if (veiculoAtual.PlacaMercosul)
                        {
                            <div class="alert alert-info py-1 mb-3">
                                <small>Formato Mercosul: <strong>AAA0A00</strong> (3 letras, 1 número, 1 letra, 2 números)</small>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info py-1 mb-3">
                                <small>Formato padrão: <strong>AAA0000</strong> (3 letras e 4 números)</small>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Modelo</label>
                                <InputText @bind-Value="veiculoAtual.Modelo" class="form-control" />
                                <ValidationMessage For="@(() => veiculoAtual.Modelo)" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Cor</label>
                                <InputText @bind-Value="veiculoAtual.Cor" class="form-control" maxlength="50" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Ano</label>
                                <InputNumber @bind-Value="veiculoAtual.Ano" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Marca</label>
                            <div class="input-group">
                                <input class="form-control" readonly value="@MarcaSelecionadaTexto" placeholder="Nenhuma selecionada" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="AbrirConsultaMarcas">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tipo</label>
                            <div class="input-group">
                                <input class="form-control" readonly value="@TipoSelecionadoTexto" placeholder="Nenhum selecionado" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="AbrirConsultaTipos">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Transportador</label>
                            <InputSelect @bind-Value="veiculoAtual.CodTransportador" class="form-select">
                                <option value="0">Selecione...</option>
                                @foreach (var t in listaTransportadores)
                                {
                                    <option value="@t.CodTransportador">@t.Nome</option>
                                }
                            </InputSelect>
                        </div>
                        @if (veiculoAtual.CodVeiculo != 0)
                        {
                            <hr class="my-2" />
                            <div class="row text-muted small">
                                <div class="col-md-4">
                                    <label class="form-label">Cadastrado em</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@veiculoAtual.DataCadastro.ToString("dd/MM/yyyy HH:mm")" disabled />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Última Alteração</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@(veiculoAtual.DataUltimaAlteracao?.ToString("dd/MM/yyyy HH:mm") ?? "—")" disabled />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Alterado por</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@(veiculoAtual.UsuarioUltimaAlteracao ?? "—")" disabled />
                                </div>
                            </div>
                        }
                        <div class="mb-3 form-check">
                            <InputCheckbox @bind-Value="veiculoAtual.Ativo" class="form-check-input" id="ativoCheckVeic" />
                            <label class="form-check-label" for="ativoCheckVeic">Ativo</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="FecharModalForm">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (modalMarcasAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5); z-index:1060">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-tags me-2"></i>Marcas</h5>
                    <button type="button" class="btn-close" @onclick="() => modalMarcasAberto = false"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-2 mb-3">
                        <input class="form-control" placeholder="Buscar por código ou nome"
                               @bind="termoMarca" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap"
                                @onclick="() => { cadastroMarcaAberto = !cadastroMarcaAberto; erroNovaMarca = null; }">
                            + Nova marca
                        </button>
                    </div>

                    @if (cadastroMarcaAberto)
                    {
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white">Nova marca</div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(erroNovaMarca))
                                {
                                    <div class="alert alert-danger py-1">@erroNovaMarca</div>
                                }
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-8">
                                        <label class="form-label">Nome da marca</label>
                                        <InputText @bind-Value="novaMarca.MarcaVeiculo" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-4">
                                        <button type="button" class="btn btn-primary btn-sm w-100" @onclick="SalvarNovaMarca">Salvar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cód.</th>
                                <th>Marca</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!MarcasFiltradas.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3">Nenhuma marca encontrada.</td></tr>
                            }
                            @foreach (var item in MarcasFiltradas)
                            {
                                <tr class="@(veiculoAtual.CodMarca == item.CodMarca ? "table-primary" : "")">
                                    <td>@item.CodMarca</td>
                                    <td>@item.MarcaVeiculo</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelecionarMarca(item)">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@if (modalTiposAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5); z-index:1060">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-truck-front me-2"></i>Tipos de veículo</h5>
                    <button type="button" class="btn-close" @onclick="() => modalTiposAberto = false"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-2 mb-3">
                        <input class="form-control" placeholder="Buscar por código ou descrição"
                               @bind="termoTipo" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap"
                                @onclick="() => { cadastroTipoAberto = !cadastroTipoAberto; erroNovoTipo = null; }">
                            + Novo tipo
                        </button>
                    </div>

                    @if (cadastroTipoAberto)
                    {
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white">Novo tipo</div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(erroNovoTipo))
                                {
                                    <div class="alert alert-danger py-1">@erroNovoTipo</div>
                                }
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-8">
                                        <label class="form-label">Descrição do tipo</label>
                                        <InputText @bind-Value="novoTipo.Tipo" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-4">
                                        <button type="button" class="btn btn-primary btn-sm w-100" @onclick="SalvarNovoTipo">Salvar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cód.</th>
                                <th>Tipo</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!TiposFiltrados.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3">Nenhum tipo encontrado.</td></tr>
                            }
                            @foreach (var item in TiposFiltrados)
                            {
                                <tr class="@(veiculoAtual.CodTipo == item.CodTipo ? "table-primary" : "")">
                                    <td>@item.CodTipo</td>
                                    <td>@item.Tipo</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelecionarTipo(item)">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Confirmação de Exclusão *@
@if (modalExcluirAberto && veiculoExcluir != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalExcluir"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">Tem certeza que deseja excluir este veículo? Esta ação não pode ser desfeita.</p>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr><th>Código</th><td>@veiculoExcluir.CodVeiculo</td></tr>
                            <tr><th>Placa</th><td>@veiculoExcluir.Placa @(veiculoExcluir.PlacaMercosul ? "(Mercosul)" : "")</td></tr>
                            <tr><th>Modelo</th><td>@veiculoExcluir.Modelo</td></tr>
                            <tr><th>Marca</th><td>@veiculoExcluir.oMarca?.MarcaVeiculo</td></tr>
                            <tr><th>Tipo</th><td>@veiculoExcluir.oTipo?.Tipo</td></tr>
                            <tr><th>Cor</th><td>@veiculoExcluir.Cor</td></tr>
                            <tr><th>Ano</th><td>@veiculoExcluir.Ano</td></tr>
                            <tr><th>Transportador</th><td>@veiculoExcluir.oTransportador?.Nome</td></tr>
                            <tr><th>Ativo</th><td>@(veiculoExcluir.Ativo ? "Sim" : "Não")</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalExcluir">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusao">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Veiculos> listaVeiculos = new();
    private List<MarcasVeiculos> listaMarcas = new();
    private List<TiposVeiculos> listaTipos = new();
    private List<Transportadores> listaTransportadores = new();
    private Veiculos veiculoAtual = new();
    private Veiculos? veiculoExcluir;
    private bool modalFormAberto = false;
    private bool modalExcluirAberto = false;
    private bool modalMarcasAberto;
    private bool cadastroMarcaAberto;
    private string termoMarca = string.Empty;
    private bool modalTiposAberto;
    private bool cadastroTipoAberto;
    private string termoTipo = string.Empty;
    private MarcasVeiculos novaMarca = new();
    private TiposVeiculos novoTipo = new();
    private string? mensagemErro;
    private string? mensagemSucesso;
    private string? mensagemErroModal;
    private string? erroNovaMarca;
    private string? erroNovoTipo;

    private IEnumerable<MarcasVeiculos> MarcasFiltradas
    {
        get
        {
            var ativas = listaMarcas.Where(m => m.Ativo);
            if (string.IsNullOrWhiteSpace(termoMarca)) return ativas;

            var termo = termoMarca.Trim().ToUpper();
            return ativas.Where(m =>
                m.CodMarca.ToString() == termo ||
                m.MarcaVeiculo.ToUpper().Contains(termo));
        }
    }

    private IEnumerable<TiposVeiculos> TiposFiltrados
    {
        get
        {
            var ativos = listaTipos.Where(t => t.Ativo);
            if (string.IsNullOrWhiteSpace(termoTipo)) return ativos;

            var termo = termoTipo.Trim().ToUpper();
            return ativos.Where(t =>
                t.CodTipo.ToString() == termo ||
                t.Tipo.ToUpper().Contains(termo));
        }
    }

    private string MarcaSelecionadaTexto
    {
        get
        {
            var marca = listaMarcas.FirstOrDefault(m => m.CodMarca == veiculoAtual.CodMarca);
            return marca == null ? "" : $"{marca.CodMarca} - {marca.MarcaVeiculo}";
        }
    }

    private string TipoSelecionadoTexto
    {
        get
        {
            var tipo = listaTipos.FirstOrDefault(t => t.CodTipo == veiculoAtual.CodTipo);
            return tipo == null ? "" : $"{tipo.CodTipo} - {tipo.Tipo}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarAuxiliares();
        await CarregarVeiculos();
    }

    private async Task CarregarAuxiliares()
    {
        listaMarcas = await marcasService.GetMarcasAsync();
        listaTipos = await tiposService.GetTiposAsync();
        listaTransportadores = await transportadoresService.GetTransportadoresAsync();
    }

    private async Task CarregarVeiculos()
    {
        listaVeiculos = await veiculosService.GetVeiculosAsync();
    }

    private void AbrirModalNovo()
    {
        veiculoAtual = new Veiculos { Ano = DateTime.Now.Year };
        mensagemErroModal = null;
        modalMarcasAberto = false;
        modalTiposAberto = false;
        modalFormAberto = true;
    }

    private void AbrirModalEditar(Veiculos v)
    {
        veiculoAtual = new Veiculos
        {
            CodVeiculo = v.CodVeiculo,
            Placa = v.Placa,
            PlacaMercosul = v.PlacaMercosul,
            Modelo = v.Modelo,
            Cor = v.Cor,
            Ano = v.Ano,
            CodMarca = v.CodMarca,
            CodTipo = v.CodTipo,
            CodTransportador = v.CodTransportador,
            DataCadastro = v.DataCadastro,
            DataUltimaAlteracao = v.DataUltimaAlteracao,
            UsuarioUltimaAlteracao = v.UsuarioUltimaAlteracao,
            Ativo = v.Ativo
        };
        mensagemErroModal = null;
        modalMarcasAberto = false;
        modalTiposAberto = false;
        modalFormAberto = true;
    }

    private void FecharModalForm()
    {
        modalFormAberto = false;
        veiculoAtual = new Veiculos();
        mensagemErroModal = null;
        modalMarcasAberto = false;
        modalTiposAberto = false;
    }

    private void AbrirModalExcluir(Veiculos v)
    {
        veiculoExcluir = v;
        modalExcluirAberto = true;
    }

    private void FecharModalExcluir()
    {
        modalExcluirAberto = false;
        veiculoExcluir = null;
    }

    private void AbrirConsultaMarcas()
    {
        termoMarca = string.Empty;
        cadastroMarcaAberto = false;
        erroNovaMarca = null;
        modalMarcasAberto = true;
    }

    private void SelecionarMarca(MarcasVeiculos marca)
    {
        veiculoAtual.CodMarca = marca.CodMarca;
        modalMarcasAberto = false;
    }

    private void AbrirConsultaTipos()
    {
        termoTipo = string.Empty;
        cadastroTipoAberto = false;
        erroNovoTipo = null;
        modalTiposAberto = true;
    }

    private void SelecionarTipo(TiposVeiculos tipo)
    {
        veiculoAtual.CodTipo = tipo.CodTipo;
        modalTiposAberto = false;
    }

    private async Task SalvarNovaMarca()
    {
        erroNovaMarca = null;
        if (string.IsNullOrWhiteSpace(novaMarca.MarcaVeiculo))
        {
            erroNovaMarca = "Nome é obrigatório.";
            return;
        }
        try
        {
            await marcasService.AddMarcaAsync(novaMarca);
            listaMarcas = await marcasService.GetMarcasAsync();
            var criada = listaMarcas.FirstOrDefault(m => m.MarcaVeiculo == novaMarca.MarcaVeiculo);
            novaMarca = new MarcasVeiculos();
            cadastroMarcaAberto = false;
            if (criada != null) SelecionarMarca(criada);
        }
        catch (Exception ex)
        {
            erroNovaMarca = ex.Message;
        }
    }

    private async Task SalvarNovoTipo()
    {
        erroNovoTipo = null;
        if (string.IsNullOrWhiteSpace(novoTipo.Tipo))
        {
            erroNovoTipo = "Descrição é obrigatória.";
            return;
        }
        try
        {
            await tiposService.AddTipoAsync(novoTipo);
            listaTipos = await tiposService.GetTiposAsync();
            var criado = listaTipos.FirstOrDefault(t => t.Tipo == novoTipo.Tipo);
            novoTipo = new TiposVeiculos();
            cadastroTipoAberto = false;
            if (criado != null) SelecionarTipo(criado);
        }
        catch (Exception ex)
        {
            erroNovoTipo = ex.Message;
        }
    }

    private async Task Salvar()
    {
        LimparMensagens();
        try
        {
            if (veiculoAtual.CodVeiculo == 0)
                await veiculosService.AddVeiculoAsync(veiculoAtual);
            else
                await veiculosService.UpdateVeiculoAsync(veiculoAtual);

            mensagemSucesso = "Veículo salvo com sucesso.";
            FecharModalForm();
            await CarregarVeiculos();
        }
        catch (Exception ex)
        {
            mensagemErroModal = ex.Message;
        }
    }

    private async Task ConfirmarExclusao()
    {
        if (veiculoExcluir == null) return;
        LimparMensagens();
        try
        {
            await veiculosService.DeleteVeiculoAsync(veiculoExcluir.CodVeiculo);
            mensagemSucesso = "Veículo excluído com sucesso.";
            FecharModalExcluir();
            await CarregarVeiculos();
        }
        catch (Exception ex)
        {
            mensagemErro = ex.Message;
            FecharModalExcluir();
        }
    }

    private void LimparMensagens()
    {
        mensagemErro = null;
        mensagemSucesso = null;
    }
}