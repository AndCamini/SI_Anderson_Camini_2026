@page "/cidades"
@rendermode InteractiveServer
@using ProjetoSalaoDeBeleza.Models
@using ProjetoSalaoDeBeleza.Services
@inject CidadesService cidadesService
@inject EstadosService estadosService
@inject PaisesService paisesService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Cidades</h3>
    <button class="btn btn-primary" @onclick="AbrirModalNovo">+ Cadastrar novo</button>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger alert-dismissible">
        @mensagemErro
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Cód</th>
            <th>Cidade</th>
            <th>Estado</th>
            <th>DDD</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in listaCidades)
        {
            <tr>
                <td>@c.CodCidade</td>
                <td>@c.Cidade</td>
                <td>@listaEstados.FirstOrDefault(e => e.CodEstado == c.CodEstado)?.Estado</td>
                <td>@c.DDD</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalEditar(c)">Editar</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => AbrirModalExcluir(c)">Excluir</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (modalAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(cidadeAtual.CodCidade == 0 ? "Nova Cidade" : "Editar Cidade")</h5>
                    <button type="button" class="btn-close" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(mensagemErroModal))
                    {
                        <div class="alert alert-danger">@mensagemErroModal</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Cidade</label>
                        <InputText @bind-Value="cidadeAtual.Cidade" class="form-control" />
                    </div>
                    <div class="mb-3">
<label class="form-label">Estado</label>
                        <div class="input-group">
                            <input class="form-control" readonly value="@EstadoTexto(cidadeAtual.CodEstado)" placeholder="Selecionar estado..." />
                            <button type="button" class="btn btn-outline-secondary" @onclick="AbrirConsultaEstados">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">DDD</label>
                        <InputNumber @bind-Value="cidadeAtual.DDD" class="form-control" style="max-width: 100px;" />
                    </div>
                    @if (cidadeAtual.CodCidade != 0)
                    {
                        <hr class="my-2" />
                        <div class="row text-muted small">
                            <div class="col-md-4">
                                <label class="form-label">Cadastrado em</label>
                                <input type="text" class="form-control form-control-sm"
                                       value="@cidadeAtual.DataCadastro.ToString("dd/MM/yyyy HH:mm")" disabled />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Última Alteração</label>
                                <input type="text" class="form-control form-control-sm"
                                       value="@(cidadeAtual.DataUltimaAlteracao?.ToString("dd/MM/yyyy HH:mm") ?? "—")" disabled />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Alterado por</label>
                                <input type="text" class="form-control form-control-sm"
                                       value="@(cidadeAtual.UsuarioUltimaAlteracao ?? "—")" disabled />
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="Salvar">Salvar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (modalEstadosAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5); z-index:1060">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-map me-2"></i>Estados</h5>
                    <button type="button" class="btn-close" @onclick="() => modalEstadosAberto = false"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-2 mb-3">
                        <input class="form-control" placeholder="Buscar por código, estado, UF ou país"
                               @bind="termoEstado" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap"
                                @onclick="() => { cadastroEstadoAberto = !cadastroEstadoAberto; erroNovoEstado = null; }">
                            + Novo estado
                        </button>
                    </div>

                    @if (cadastroEstadoAberto)
                    {
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white">Novo estado</div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(erroNovoEstado))
                                {
                                    <div class="alert alert-danger py-1">@erroNovoEstado</div>
                                }
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <label class="form-label">Estado</label>
                                        <InputText @bind-Value="novoEstado.Estado" class="form-control form-control-sm" maxlength="25" />
                                    </div>
                                    <div class="col-4 col-md-2">
                                        <label class="form-label">UF</label>
                                        <InputText @bind-Value="novoEstado.UF" class="form-control form-control-sm" maxlength="3" placeholder="PR" />
                                    </div>
                                    <div class="col-8 col-md-5">
                                        <label class="form-label">País</label>
                                        <div class="input-group input-group-sm">
                                            <input class="form-control" readonly value="@PaisTexto(novoEstado.CodPais)" placeholder="Selecionar país..." />
                                            <button type="button" class="btn btn-outline-secondary" @onclick="AbrirConsultaPaises">
                                                <i class="bi bi-search"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="SalvarNovoEstado">Salvar</button>
                            </div>
                        </div>
                    }

                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cód.</th>
                                <th>Estado</th>
                                <th>UF</th>
                                <th>País</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!EstadosFiltrados.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">Nenhum estado encontrado.</td></tr>
                            }
                            @foreach (var e in EstadosFiltrados)
                            {
                                <tr class="@(cidadeAtual.CodEstado == e.CodEstado ? "table-primary" : "")">
                                    <td>@e.CodEstado</td>
                                    <td>@e.Estado</td>
                                    <td>@e.UF</td>
                                    <td>@PaisTexto(e.CodPais)</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelecionarEstado(e)">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@if (modalPaisesAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5); z-index:1070">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-flag me-2"></i>Países</h5>
                    <button type="button" class="btn-close" @onclick="() => modalPaisesAberto = false"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-2 mb-3">
                        <input class="form-control" placeholder="Buscar por código, país ou sigla"
                               @bind="termoPais" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap"
                                @onclick="() => { cadastroPaisAberto = !cadastroPaisAberto; erroNovoPais = null; }">
                            + Novo país
                        </button>
                    </div>

                    @if (cadastroPaisAberto)
                    {
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white">Novo país</div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(erroNovoPais))
                                {
                                    <div class="alert alert-danger py-1">@erroNovoPais</div>
                                }
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <label class="form-label">País</label>
                                        <InputText @bind-Value="novoPais.Pais" class="form-control form-control-sm" maxlength="25" />
                                    </div>
                                    <div class="col-4 col-md-2">
                                        <label class="form-label">Sigla</label>
                                        <InputText @bind-Value="novoPais.Sigla" class="form-control form-control-sm" maxlength="3" placeholder="BR" />
                                    </div>
                                    <div class="col-4 col-md-2">
                                        <label class="form-label">DDI</label>
                                        <InputText @bind-Value="novoPais.DDI" class="form-control form-control-sm" maxlength="5" placeholder="55" />
                                    </div>
                                    <div class="col-4 col-md-3">
                                        <label class="form-label">Moeda</label>
                                        <InputText @bind-Value="novoPais.Moeda" class="form-control form-control-sm" maxlength="25" placeholder="Real" />
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="SalvarNovoPais">Salvar</button>
                            </div>
                        </div>
                    }

                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cód.</th>
                                <th>País</th>
                                <th>Sigla</th>
                                <th>DDI</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!PaisesFiltrados.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">Nenhum país encontrado.</td></tr>
                            }
                            @foreach (var p in PaisesFiltrados)
                            {
                                <tr class="@(novoEstado.CodPais == p.CodPais ? "table-primary" : "")">
                                    <td>@p.CodPais</td>
                                    <td>@p.Pais</td>
                                    <td>@p.Sigla</td>
                                    <td>@p.DDI</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelecionarPais(p)">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@if (modalExcluirAberto && cidadeExcluir != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalExcluir"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">Tem certeza que deseja excluir esta cidade? Esta ação não pode ser desfeita.</p>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr><th>Código</th><td>@cidadeExcluir.CodCidade</td></tr>
                            <tr><th>Cidade</th><td>@cidadeExcluir.Cidade</td></tr>
                            <tr><th>Estado</th><td>@listaEstados.FirstOrDefault(e => e.CodEstado == cidadeExcluir.CodEstado)?.Estado</td></tr>
                            <tr><th>DDD</th><td>@cidadeExcluir.DDD</td></tr>
                            
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalExcluir">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusao">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Cidades> listaCidades = new();
    private List<Estados> listaEstados = new();
    private Cidades cidadeAtual = new();
    private bool modalAberto = false;
    private string? mensagemErro;
    private string? mensagemSucesso;
    private string? mensagemErroModal;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        listaCidades = await cidadesService.GetCidadesAsync();
        listaEstados = await estadosService.GetEstadosAsync();
        listaPaises = await paisesService.GetPaisesAsync();
    }

    private void AbrirModalNovo()
    {
        cidadeAtual = new Cidades();
        mensagemErroModal = null;
        modalAberto = true;
    }

    private void AbrirModalEditar(Cidades c)
    {
        cidadeAtual = new Cidades
        {
            CodCidade = c.CodCidade,
            Cidade = c.Cidade,
            CodEstado = c.CodEstado,
            DDD = c.DDD,
            DataCadastro = c.DataCadastro,
            DataUltimaAlteracao = c.DataUltimaAlteracao,
            UsuarioUltimaAlteracao = c.UsuarioUltimaAlteracao
        };
        mensagemErroModal = null;
        modalAberto = true;
    }

    private List<Paises> listaPaises = new();
    private bool modalEstadosAberto;
    private bool cadastroEstadoAberto;
    private string termoEstado = string.Empty;
    private Estados novoEstado = new();
    private string? erroNovoEstado;

    private IEnumerable<Estados> EstadosFiltrados
    {
        get
        {
            var ordenados = listaEstados.OrderBy(e => e.Estado);
            if (string.IsNullOrWhiteSpace(termoEstado)) return ordenados;

            var termo = termoEstado.Trim().ToUpper();
            return ordenados.Where(e =>
                e.CodEstado.ToString() == termo ||
                (e.Estado ?? "").ToUpper().Contains(termo) ||
                (e.UF ?? "").ToUpper() == termo ||
                PaisTexto(e.CodPais).ToUpper().Contains(termo));
        }
    }

    private string EstadoTexto(int codEstado)
    {
        var estado = listaEstados.FirstOrDefault(e => e.CodEstado == codEstado);
        return estado == null ? "" : $"{estado.CodEstado} - {estado.Estado} - {estado.UF}";
    }

    private void AbrirConsultaEstados()
    {
        termoEstado = string.Empty;
        cadastroEstadoAberto = false;
        erroNovoEstado = null;
        novoEstado = new Estados();
        modalEstadosAberto = true;
    }

    private void SelecionarEstado(Estados estado)
    {
        cidadeAtual.CodEstado = estado.CodEstado;
        modalEstadosAberto = false;
    }

    private async Task SalvarNovoEstado()
    {
        erroNovoEstado = null;
        try
        {
            await estadosService.AddEstadoAsync(novoEstado);
            listaEstados = await estadosService.GetEstadosAsync();
            var criado = listaEstados.FirstOrDefault(e => e.CodEstado == novoEstado.CodEstado);
            novoEstado = new Estados();
            cadastroEstadoAberto = false;
            if (criado != null) SelecionarEstado(criado);
        }
        catch (Exception ex)
        {
            erroNovoEstado = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private bool modalPaisesAberto;
    private bool cadastroPaisAberto;
    private string termoPais = string.Empty;
    private Paises novoPais = new();
    private string? erroNovoPais;

    private IEnumerable<Paises> PaisesFiltrados
    {
        get
        {
            var ordenados = listaPaises.OrderBy(p => p.Pais);
            if (string.IsNullOrWhiteSpace(termoPais)) return ordenados;

            var termo = termoPais.Trim().ToUpper();
            return ordenados.Where(p =>
                p.CodPais.ToString() == termo ||
                (p.Pais ?? "").ToUpper().Contains(termo) ||
                (p.Sigla ?? "").ToUpper() == termo);
        }
    }

    private string PaisTexto(int codPais)
    {
        var pais = listaPaises.FirstOrDefault(p => p.CodPais == codPais);
        return pais == null ? "" : $"{pais.CodPais} - {pais.Pais}";
    }

    private void AbrirConsultaPaises()
    {
        termoPais = string.Empty;
        cadastroPaisAberto = false;
        erroNovoPais = null;
        modalPaisesAberto = true;
    }

    private void SelecionarPais(Paises pais)
    {
        novoEstado.CodPais = pais.CodPais;
        modalPaisesAberto = false;
    }

    private async Task SalvarNovoPais()
    {
        erroNovoPais = null;
        try
        {
            await paisesService.AddPaisAsync(novoPais);
            listaPaises = await paisesService.GetPaisesAsync();
            var criado = listaPaises.FirstOrDefault(p => p.CodPais == novoPais.CodPais);
            novoPais = new Paises();
            cadastroPaisAberto = false;
            if (criado != null) SelecionarPais(criado);
        }
        catch (Exception ex)
        {
            erroNovoPais = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private void FecharModal()
    {
        modalAberto = false;
        modalEstadosAberto = false;
        modalPaisesAberto = false;
        cidadeAtual = new Cidades();
        mensagemErroModal = null;
    }

    private async Task Salvar()
    {
        LimparMensagens();
        try
        {
            if (cidadeAtual.CodCidade == 0)
                await cidadesService.AddCidadeAsync(cidadeAtual);
            else
                await cidadesService.UpdateCidadeAsync(cidadeAtual);

            mensagemSucesso = "Cidade salva com sucesso.";
            FecharModal();
            await CarregarDados();
        }
        catch (Exception ex)
        {
            mensagemErroModal = ex.Message;
        }
    }

    private Cidades? cidadeExcluir;
    private bool modalExcluirAberto = false;

    private void AbrirModalExcluir(Cidades c)
    {
        cidadeExcluir = c;
        modalExcluirAberto = true;
    }

    private void FecharModalExcluir()
    {
        modalExcluirAberto = false;
        cidadeExcluir = null;
    }

    private async Task ConfirmarExclusao()
    {
        if (cidadeExcluir == null) return;
        LimparMensagens();
        try
        {
            await cidadesService.DeleteCidadeAsync(cidadeExcluir.CodCidade);
            mensagemSucesso = "Cidade excluída com sucesso.";
            FecharModalExcluir();
            await CarregarDados();
        }
        catch (Exception ex)
        {
            mensagemErro = ex.Message;
            FecharModalExcluir();
        }
    }

    private void LimparMensagens()
    {
        mensagemErro = null;
        mensagemSucesso = null;
    }
}