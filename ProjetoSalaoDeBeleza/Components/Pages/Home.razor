@page "/"
@rendermode InteractiveServer
@using ProjetoSalaoDeBeleza.Models
@using ProjetoSalaoDeBeleza.Services
@inject ClientesService clientesService
@inject FuncionariosService funcionariosService
@inject ProdutosService produtosService
@inject FornecedoresService fornecedoresService
@inject TransportadoresService transportadoresService

<PageTitle>Salão de Beleza</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Bem-vindo ao Sistema</h2>
        <small class="text-muted">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))</small>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-people fs-4 text-primary"></i>
                </div>
                <div>
                    <div class="text-muted small">Clientes</div>
                    <div class="fw-bold fs-4">@totalClientes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="bi bi-person-badge fs-4 text-success"></i>
                </div>
                <div>
                    <div class="text-muted small">Funcionários</div>
                    <div class="fw-bold fs-4">@totalFuncionarios</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                    <i class="bi bi-box-seam fs-4 text-warning"></i>
                </div>
                <div>
                    <div class="text-muted small">Produtos</div>
                    <div class="fw-bold fs-4">@totalProdutos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 p-3">
                    <i class="bi bi-truck fs-4 text-info"></i>
                </div>
                <div>
                    <div class="text-muted small">Fornecedores</div>
                    <div class="fw-bold fs-4">@totalFornecedores</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                    <i class="bi bi-car-front fs-4 text-danger"></i>
                </div>
                <div>
                    <div class="text-muted small">Transportadores</div>
                    <div class="fw-bold fs-4">@totalTransportadores</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent fw-semibold">Acesso Rápido — Cadastros</div>
            <div class="card-body d-flex flex-wrap gap-2">
                <a href="/clientes" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-people me-1"></i>Clientes
                </a>
                <a href="/funcionarios" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-person-badge me-1"></i>Funcionários
                </a>
                <a href="/fornecedores" class="btn btn-outline-info btn-sm">
                    <i class="bi bi-truck me-1"></i>Fornecedores
                </a>
                <a href="/transportadores" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-car-front me-1"></i>Transportadores
                </a>
                <a href="/produtos" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-box-seam me-1"></i>Produtos
                </a>
                <a href="/categorias" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-tag me-1"></i>Categorias
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent fw-semibold">Acesso Rápido — Financeiro e Localidades</div>
            <div class="card-body d-flex flex-wrap gap-2">
                <a href="/condicoes-pagamento" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-credit-card me-1"></i>Condições de Pagamento
                </a>
                <a href="/formas-pagamento" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-credit-card-2-front me-1"></i>Formas de Pagamento
                </a>
                <a href="/paises" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-flag me-1"></i>Países
                </a>
                <a href="/estados" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-map me-1"></i>Estados
                </a>
                <a href="/cidades" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-building me-1"></i>Cidades
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private int totalClientes;
    private int totalFuncionarios;
    private int totalProdutos;
    private int totalFornecedores;
    private int totalTransportadores;

    protected override async Task OnInitializedAsync()
    {
        var clientes = await clientesService.GetClientesAsync();
        var funcionarios = await funcionariosService.GetFuncionariosAsync();
        var produtos = await produtosService.GetProdutosAsync();
        var fornecedores = await fornecedoresService.GetFornecedoresAsync();
        var transportadores = await transportadoresService.GetTransportadoresAsync();

        totalClientes = clientes.Count;
        totalFuncionarios = funcionarios.Count;
        totalProdutos = produtos.Count;
        totalFornecedores = fornecedores.Count;
        totalTransportadores = transportadores.Count;
    }
}