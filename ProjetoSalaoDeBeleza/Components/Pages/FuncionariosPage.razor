@page "/funcionarios"
@rendermode InteractiveServer
@using ProjetoSalaoDeBeleza.Models
@using ProjetoSalaoDeBeleza.Services
@inject FuncionariosService funcionariosService
@inject CidadesService cidadesService
@inject EstadosService estadosService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Funcionários</h3>
    <button class="btn btn-primary" @onclick="AbrirModalNovo">+ Cadastrar novo</button>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger alert-dismissible">
        @mensagemErro
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Cód</th>
            <th>Nome</th>
            <th>Tipo</th>
            <th>CPF/CNPJ</th>
            <th>Cargo</th>
            <th>Salário</th>
            <th>Admissão</th>
            <th>Cidade</th>
            <th>Ativo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in listaFuncionarios)
        {
            <tr>
                <td>@f.CodPessoa</td>
                <td>@f.Nome</td>
                <td>@(f.PessoaJuridica ? "PJ" : "PF")</td>
                <td>@f.CPF</td>
                <td>@f.Cargo</td>
                <td>@f.Salario.ToString("C2")</td>
                <td>@f.DataAdmissao.ToString("dd/MM/yyyy")</td>
                <td>@f.oCidade?.Cidade</td>
                <td>@(f.Ativo ? "Sim" : "Não")</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalEditar(f)">Editar</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => AbrirModalExcluir(f)">Excluir</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Modal Cadastro/Edição *@
@if (modalFormAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(funcionarioAtual.CodPessoa == 0 ? "Novo Funcionário" : "Editar Funcionário")</h5>
                    <button type="button" class="btn-close" @onclick="FecharModalForm"></button>
                </div>
                <EditForm Model="@funcionarioAtual" OnValidSubmit="Salvar" FormName="formFuncionarios">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensagemErroModal))
                        {
                            <div class="alert alert-danger">@mensagemErroModal</div>
                        }
                        <div class="row g-3">
                            <div class="col-6 col-md-2">
                                <label class="form-label">Tipo de Pessoa <span class="text-danger">*</span></label>
                                <select class="form-select" value="@(funcionarioAtual.PessoaJuridica ? "J" : "F")" @onchange="AlterarTipoPessoa">
                                    <option value="F">Física</option>
                                    <option value="J">Jurídica</option>
                                </select>
                            </div>
                            <div class="col-auto">
                                <label class="form-label d-block">Status</label>
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox @bind-Value="funcionarioAtual.Ativo" class="form-check-input" role="switch" id="ativoCheckFunc" />
                                    <label class="form-check-label @(funcionarioAtual.Ativo ? "text-success" : "text-muted")" for="ativoCheckFunc">@(funcionarioAtual.Ativo ? "Ativo" : "Inativo")</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Funcionário <span class="text-danger">*</span></label>
                                <InputText @bind-Value="funcionarioAtual.Nome" class="form-control" placeholder="Digite o nome completo" />
                                <ValidationMessage For="@(() => funcionarioAtual.Nome)" />
                            </div>
                            <div class="col-4 col-md-2">
                                <label class="form-label">CEP</label>
                                <InputText @bind-Value="funcionarioAtual.CEP" class="form-control" maxlength="8" placeholder="Somente números" />
                            </div>
                            <div class="col-8 col-md-8">
                                <label class="form-label">Logradouro</label>
                                <InputText @bind-Value="funcionarioAtual.Logradouro" class="form-control" placeholder="Rua, avenida, alameda..." />
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label">Número</label>
                                <InputText @bind-Value="funcionarioAtual.Numero" class="form-control" maxlength="10" placeholder="Nº" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">Cidade</label>
                                <div class="input-group">
                                    <input class="form-control" readonly value="@CidadeSelecionadaTexto" placeholder="Selecionar cidade..." />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="AbrirConsultaCidades">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="w-100 mt-0"></div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Complemento</label>
                                <InputText @bind-Value="funcionarioAtual.Complemento" class="form-control" placeholder="Apto, bloco, sala..." />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Bairro</label>
                                <InputText @bind-Value="funcionarioAtual.Bairro" class="form-control" placeholder="Bairro" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">E-mail</label>
                                <InputText @bind-Value="funcionarioAtual.Email" class="form-control" placeholder="email@exemplo.com" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Telefone</label>
                                <InputText @bind-Value="funcionarioAtual.Telefone" class="form-control" maxlength="15" placeholder="(00) 00000-0000" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@(funcionarioAtual.PessoaJuridica ? "CNPJ" : "CPF") <span class="text-danger">*</span></label>
                                <InputText @bind-Value="funcionarioAtual.CPF" class="form-control"
                                           maxlength="@(funcionarioAtual.PessoaJuridica ? 14 : 11)"
                                           placeholder="Somente números" />
                                <ValidationMessage For="@(() => funcionarioAtual.CPF)" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">Data de Nascimento</label>
                                <InputDate @bind-Value="funcionarioAtual.DataNascimento" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">Cargo</label>
                                <InputText @bind-Value="funcionarioAtual.Cargo" class="form-control" maxlength="30" placeholder="Cargo" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Salário (R$)</label>
                                <InputNumber @bind-Value="funcionarioAtual.Salario" class="form-control" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Comissão (%)</label>
                                <InputNumber @bind-Value="funcionarioAtual.ComissaoPercentual" class="form-control" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Data de Admissão <span class="text-danger">*</span></label>
                                <InputDate @bind-Value="funcionarioAtual.DataAdmissao" class="form-control" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Data de Demissão</label>
                                <InputDate @bind-Value="funcionarioAtual.DataDemissao" class="form-control" />
                            </div>
                        </div>
                        @if (funcionarioAtual.CodPessoa != 0)
                        {
                            <hr class="my-3" />
                            <div class="row g-3 text-muted small">
                                <div class="col-md-4">
                                    <label class="form-label">Cadastrado em</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@funcionarioAtual.DataCadastro.ToString("dd/MM/yyyy HH:mm")" disabled />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Última Alteração</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@(funcionarioAtual.DataUltimaAlteracao?.ToString("dd/MM/yyyy HH:mm") ?? "—")" disabled />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Alterado por</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@(funcionarioAtual.UsuarioUltimaAlteracao ?? "—")" disabled />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-dark px-4">Salvar</button>
                        <button type="button" class="btn btn-link text-secondary text-decoration-none" @onclick="FecharModalForm">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (modalCidadesAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5); z-index:1060">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-geo-alt me-2"></i>Cidades</h5>
                    <button type="button" class="btn-close" @onclick="() => modalCidadesAberto = false"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-2 mb-3">
                        <input class="form-control" placeholder="Buscar por código, cidade ou UF"
                               @bind="termoCidade" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap"
                                @onclick="() => { cadastroCidadeAberto = !cadastroCidadeAberto; erroNovaCidade = null; }">
                            + Nova cidade
                        </button>
                    </div>

                    @if (cadastroCidadeAberto)
                    {
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white">Nova cidade</div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(erroNovaCidade))
                                {
                                    <div class="alert alert-danger py-1">@erroNovaCidade</div>
                                }
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <label class="form-label">Nome</label>
                                        <InputText @bind-Value="novaCidade.Cidade" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label">Estado</label>
                                        <InputSelect @bind-Value="novaCidade.CodEstado" class="form-select form-select-sm">
                                            <option value="0">Selecione...</option>
                                            @foreach (var estado in listaEstados)
                                            {
                                                <option value="@estado.CodEstado">@estado.Estado - @estado.UF</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">DDD</label>
                                        <InputNumber @bind-Value="novaCidade.DDD" class="form-control form-control-sm text-end" />
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="SalvarNovaCidade">Salvar</button>
                            </div>
                        </div>
                    }

                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cód.</th>
                                <th>Cidade</th>
                                <th>UF</th>
                                <th class="text-end">DDD</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!CidadesFiltradas.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">Nenhuma cidade encontrada.</td></tr>
                            }
                            @foreach (var c in CidadesFiltradas)
                            {
                                <tr class="@(funcionarioAtual.CodCidade == c.CodCidade ? "table-primary" : "")">
                                    <td>@c.CodCidade</td>
                                    <td>@c.Cidade</td>
                                    <td>@c.oEstado?.UF</td>
                                    <td class="text-end">@c.DDD</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelecionarCidade(c)">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Confirmação de Exclusão *@
@if (modalExcluirAberto && funcionarioExcluir != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalExcluir"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">Tem certeza que deseja excluir este funcionário? Esta ação não pode ser desfeita.</p>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr><th>Código</th><td>@funcionarioExcluir.CodPessoa</td></tr>
                            <tr><th>Nome</th><td>@funcionarioExcluir.Nome</td></tr>
                            <tr><th>CPF</th><td>@funcionarioExcluir.CPF</td></tr>
                            <tr><th>Email</th><td>@funcionarioExcluir.Email</td></tr>
                            <tr><th>Cargo</th><td>@funcionarioExcluir.Cargo</td></tr>
                            <tr><th>Salário</th><td>@funcionarioExcluir.Salario.ToString("C2")</td></tr>
                            <tr><th>Admissão</th><td>@funcionarioExcluir.DataAdmissao.ToString("dd/MM/yyyy")</td></tr>
                            <tr><th>Demissão</th><td>@(funcionarioExcluir.DataDemissao?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                            <tr><th>Comissão</th><td>@funcionarioExcluir.ComissaoPercentual.ToString("P2")</td></tr>
                            <tr><th>Cidade</th><td>@funcionarioExcluir.oCidade?.Cidade</td></tr>
                            <tr><th>Ativo</th><td>@(funcionarioExcluir.Ativo ? "Sim" : "Não")</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalExcluir">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusao">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Funcionarios> listaFuncionarios = new();
    private List<Cidades> listaCidades = new();
    private Funcionarios funcionarioAtual = new();
    private Funcionarios? funcionarioExcluir;
    private bool modalFormAberto = false;
    private bool modalExcluirAberto = false;
    private string? mensagemErro;
    private string? mensagemSucesso;
    private string? mensagemErroModal;
    private List<Estados> listaEstados = new();
    private Cidades novaCidade = new();
    private bool modalCidadesAberto;
    private bool cadastroCidadeAberto;
    private string termoCidade = string.Empty;
    private string? erroNovaCidade;

    private IEnumerable<Cidades> CidadesFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(termoCidade)) return listaCidades;

            var termo = termoCidade.Trim().ToUpper();
            return listaCidades.Where(c =>
                c.CodCidade.ToString() == termo ||
                (c.Cidade ?? "").ToUpper().Contains(termo) ||
                (c.oEstado?.UF ?? "").ToUpper() == termo);
        }
    }

    private string CidadeSelecionadaTexto
    {
        get
        {
            var cidade = listaCidades.FirstOrDefault(c => c.CodCidade == funcionarioAtual.CodCidade);
            return cidade == null ? "" : $"{cidade.CodCidade} - {cidade.Cidade} - {cidade.oEstado?.UF}";
        }
    }

    private void AbrirConsultaCidades()
    {
        termoCidade = string.Empty;
        cadastroCidadeAberto = false;
        erroNovaCidade = null;
        modalCidadesAberto = true;
    }

    private void SelecionarCidade(Cidades cidade)
    {
        funcionarioAtual.CodCidade = cidade.CodCidade;
        modalCidadesAberto = false;
    }

    protected override async Task OnInitializedAsync()
    {
        listaCidades = await cidadesService.GetCidadesAsync();
        listaEstados = await estadosService.GetEstadosAsync();
        await CarregarFuncionarios();
    }

    private async Task CarregarFuncionarios()
    {
        listaFuncionarios = await funcionariosService.GetFuncionariosAsync();
    }

    private void AbrirModalNovo()
    {
        funcionarioAtual = new Funcionarios();
        mensagemErroModal = null;
        modalFormAberto = true;
    }

    private void AbrirModalEditar(Funcionarios f)
    {
        funcionarioAtual = new Funcionarios
        {
            CodPessoa = f.CodPessoa,
            Nome = f.Nome,
            CPF = f.CPF,
            Email = f.Email,
            Telefone = f.Telefone,
            DataNascimento = f.DataNascimento,
            DataCadastro = f.DataCadastro,
            Ativo = f.Ativo,
            CodCidade = f.CodCidade,
            Cargo = f.Cargo,
            Salario = f.Salario,
            DataAdmissao = f.DataAdmissao,
            DataDemissao = f.DataDemissao,
            ComissaoPercentual = f.ComissaoPercentual,
            CEP = f.CEP,
            Logradouro = f.Logradouro,
            Numero = f.Numero,
            Bairro = f.Bairro,
            Complemento = f.Complemento,
            PessoaJuridica = f.PessoaJuridica,
            DataUltimaAlteracao = f.DataUltimaAlteracao,
            UsuarioUltimaAlteracao = f.UsuarioUltimaAlteracao
        };
        mensagemErroModal = null;
        modalFormAberto = true;
    }

    private void AlterarTipoPessoa(ChangeEventArgs e)
    {
        funcionarioAtual.PessoaJuridica = e.Value?.ToString() == "J";
        funcionarioAtual.CPF = string.Empty;
    }

    private void FecharModalForm()
    {
        modalFormAberto = false;
        funcionarioAtual = new Funcionarios();
        mensagemErroModal = null;
    }

    private void AbrirModalExcluir(Funcionarios f)
    {
        funcionarioExcluir = f;
        modalExcluirAberto = true;
    }

    private void FecharModalExcluir()
    {
        modalExcluirAberto = false;
        funcionarioExcluir = null;
    }

    private async Task Salvar()
    {
        LimparMensagens();
        try
        {
            if (funcionarioAtual.CodPessoa == 0)
                await funcionariosService.AddFuncionarioAsync(funcionarioAtual);
            else
                await funcionariosService.UpdateFuncionarioAsync(funcionarioAtual);

            mensagemSucesso = "Funcionário salvo com sucesso.";
            FecharModalForm();
            await CarregarFuncionarios();
        }
        catch (Exception ex)
        {
            mensagemErroModal = ex.Message;
        }
    }

    private async Task SalvarNovaCidade()
    {
        erroNovaCidade = null;
        if (string.IsNullOrWhiteSpace(novaCidade.Cidade))
        {
            erroNovaCidade = "Nome é obrigatório.";
            return;
        }
        if (novaCidade.CodEstado == 0)
        {
            erroNovaCidade = "Selecione um estado.";
            return;
        }
        try
        {
            await cidadesService.AddCidadeAsync(novaCidade);
            listaCidades = await cidadesService.GetCidadesAsync();
            var criada = listaCidades.FirstOrDefault(c => c.Cidade == novaCidade.Cidade.ToUpper() && c.CodEstado == novaCidade.CodEstado);
            novaCidade = new Cidades();
            cadastroCidadeAberto = false;
            if (criada != null) SelecionarCidade(criada);
        }
        catch (Exception ex)
        {
            erroNovaCidade = ex.Message;
        }
    }

    private async Task ConfirmarExclusao()
    {
        if (funcionarioExcluir == null) return;
        LimparMensagens();
        try
        {
            await funcionariosService.DeleteFuncionarioAsync(funcionarioExcluir.CodPessoa);
            mensagemSucesso = "Funcionário excluído com sucesso.";
            FecharModalExcluir();
            await CarregarFuncionarios();
        }
        catch (Exception ex)
        {
            mensagemErro = ex.Message;
            FecharModalExcluir();
        }
    }

    private void LimparMensagens()
    {
        mensagemErro = null;
        mensagemSucesso = null;
    }
}