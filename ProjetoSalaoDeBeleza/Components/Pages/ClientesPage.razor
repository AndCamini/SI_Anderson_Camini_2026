@page "/clientes"
@rendermode InteractiveServer
@using ProjetoSalaoDeBeleza.Models
@using ProjetoSalaoDeBeleza.Services
@inject ClientesService clientesService
@inject CidadesService cidadesService
@inject CondicaoPagamentoService condicaoPagamentoService
@inject EstadosService estadosService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Clientes</h3>
    <button class="btn btn-primary" @onclick="AbrirModalNovo">+ Cadastrar novo</button>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger alert-dismissible">
        @mensagemErro
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Cód</th>
            <th>Nome</th>
            <th>Tipo</th>
            <th>CPF/CNPJ</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Nascimento</th>
            <th>Cidade</th>
            <th>Notificações</th>
            <th>Ativo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in listaClientes)
        {
            <tr>
                <td>@c.CodPessoa</td>
                <td>@c.Nome</td>
                <td>@(c.PessoaJuridica ? "PJ" : "PF")</td>
                <td>@c.CPF</td>
                <td>@c.Email</td>
                <td>@c.Telefone</td>
                <td>@c.DataNascimento.ToString("dd/MM/yyyy")</td>
                <td>@c.oCidade?.Cidade</td>
                <td>@(c.RecebeNotificacoes ? "Sim" : "Não")</td>
                <td>@(c.Ativo ? "Sim" : "Não")</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalEditar(c)">Editar</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => AbrirModalExcluir(c)">Excluir</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Modal Cadastro/Edição *@
@if (modalFormAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(clienteAtual.CodPessoa == 0 ? "Novo Cliente" : "Editar Cliente")</h5>
                    <button type="button" class="btn-close" @onclick="FecharModalForm"></button>
                </div>
                <EditForm Model="@clienteAtual" OnValidSubmit="Salvar">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensagemErroModal))
                        {
                            <div class="alert alert-danger">@mensagemErroModal</div>
                        }
                        <div class="row g-3">
                            <div class="col-6 col-md-2">
                                <label class="form-label">Tipo de Pessoa <span class="text-danger">*</span></label>
                                <select class="form-select" value="@(clienteAtual.PessoaJuridica ? "J" : "F")" @onchange="AlterarTipoPessoa">
                                    <option value="F">Física</option>
                                    <option value="J">Jurídica</option>
                                </select>
                            </div>
                            <div class="col-auto">
                                <label class="form-label d-block">Status</label>
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox @bind-Value="clienteAtual.Ativo" class="form-check-input" role="switch" id="ativoCheckCliente" />
                                    <label class="form-check-label @(clienteAtual.Ativo ? "text-success" : "text-muted")" for="ativoCheckCliente">@(clienteAtual.Ativo ? "Ativo" : "Inativo")</label>
                                </div>
                            </div>
                            <div class="col-auto">
                                <label class="form-label d-block">Notificações</label>
                                <div class="form-check form-switch mt-2">
                                    <InputCheckbox @bind-Value="clienteAtual.RecebeNotificacoes" class="form-check-input" role="switch" id="notifCheck" />
                                    <label class="form-check-label" for="notifCheck">@(clienteAtual.RecebeNotificacoes ? "Recebe" : "Não recebe")</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Cliente <span class="text-danger">*</span></label>
                                <InputText @bind-Value="clienteAtual.Nome" class="form-control" placeholder="Digite o nome completo" />
                                <ValidationMessage For="@(() => clienteAtual.Nome)" />
                            </div>
                            <div class="col-4 col-md-2">
                                <label class="form-label">CEP</label>
                                <InputText @bind-Value="clienteAtual.CEP" class="form-control" maxlength="8" placeholder="Somente números" />
                            </div>
                            <div class="col-8 col-md-8">
                                <label class="form-label">Logradouro</label>
                                <InputText @bind-Value="clienteAtual.Logradouro" class="form-control" placeholder="Rua, avenida, alameda..." />
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label">Número</label>
                                <InputText @bind-Value="clienteAtual.Numero" class="form-control" maxlength="10" placeholder="Nº" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">Cidade</label>
                                <div class="input-group">
                                    <input class="form-control" readonly value="@CidadeSelecionadaTexto" placeholder="Selecionar cidade..." />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="AbrirConsultaCidades">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="w-100 mt-0"></div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Complemento</label>
                                <InputText @bind-Value="clienteAtual.Complemento" class="form-control" placeholder="Apto, bloco, sala..." />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Bairro</label>
                                <InputText @bind-Value="clienteAtual.Bairro" class="form-control" placeholder="Bairro" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">E-mail</label>
                                <InputText @bind-Value="clienteAtual.Email" class="form-control" placeholder="email@exemplo.com" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Telefone</label>
                                <InputText @bind-Value="clienteAtual.Telefone" class="form-control" maxlength="15" placeholder="(00) 00000-0000" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@(clienteAtual.PessoaJuridica ? "CNPJ" : "CPF")</label>
                                <InputText @bind-Value="clienteAtual.CPF" class="form-control"
                                           maxlength="@(clienteAtual.PessoaJuridica ? 14 : 11)"
                                           placeholder="Somente números" />
                                <ValidationMessage For="@(() => clienteAtual.CPF)" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">Data de Nascimento</label>
                                <InputDate @bind-Value="clienteAtual.DataNascimento" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Condição de Pagamento</label>
                                <InputSelect @bind-Value="clienteAtual.CodCondicaoPagamento" class="form-select">
                                    <option value="">Selecionar...</option>
                                    @foreach (var cp in listaCondicoes)
                                    {
                                        <option value="@cp.CodCondicao">@cp.Descricao</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Observações</label>
                                <InputTextArea @bind-Value="clienteAtual.Observacoes" class="form-control" rows="2" placeholder="Observações adicionais" />
                            </div>
                        </div>
                        @if (clienteAtual.CodPessoa != 0)
                        {
                            <hr class="my-3" />
                            <div class="row g-3 text-muted small">
                                <div class="col-md-4">
                                    <label class="form-label">Cadastrado em</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@clienteAtual.DataCadastro.ToString("dd/MM/yyyy HH:mm")" disabled />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Última Alteração</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@(clienteAtual.DataUltimaAlteracao?.ToString("dd/MM/yyyy HH:mm") ?? "—")" disabled />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Alterado por</label>
                                    <input type="text" class="form-control form-control-sm"
                                           value="@(clienteAtual.UsuarioUltimaAlteracao ?? "—")" disabled />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-dark px-4">Salvar</button>
                        <button type="button" class="btn btn-link text-secondary text-decoration-none" @onclick="FecharModalForm">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (modalCidadesAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5); z-index:1060">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-geo-alt me-2"></i>Cidades</h5>
                    <button type="button" class="btn-close" @onclick="() => modalCidadesAberto = false"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-2 mb-3">
                        <input class="form-control" placeholder="Buscar por código, cidade ou UF"
                               @bind="termoCidade" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary text-nowrap"
                                @onclick="() => { cadastroCidadeAberto = !cadastroCidadeAberto; erroNovaCidade = null; }">
                            + Nova cidade
                        </button>
                    </div>

                    @if (cadastroCidadeAberto)
                    {
                        <div class="card border-primary mb-3">
                            <div class="card-header bg-primary text-white">Nova cidade</div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(erroNovaCidade))
                                {
                                    <div class="alert alert-danger py-1">@erroNovaCidade</div>
                                }
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <label class="form-label">Nome</label>
                                        <InputText @bind-Value="novaCidade.Cidade" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label">Estado</label>
                                        <InputSelect @bind-Value="novaCidade.CodEstado" class="form-select form-select-sm">
                                            <option value="0">Selecione...</option>
                                            @foreach (var estado in listaEstados)
                                            {
                                                <option value="@estado.CodEstado">@estado.Estado - @estado.UF</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">DDD</label>
                                        <InputNumber @bind-Value="novaCidade.DDD" class="form-control form-control-sm text-end" />
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="SalvarNovaCidade">Salvar</button>
                            </div>
                        </div>
                    }

                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cód.</th>
                                <th>Cidade</th>
                                <th>UF</th>
                                <th class="text-end">DDD</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!CidadesFiltradas.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">Nenhuma cidade encontrada.</td></tr>
                            }
                            @foreach (var c in CidadesFiltradas)
                            {
                                <tr class="@(clienteAtual.CodCidade == c.CodCidade ? "table-primary" : "")">
                                    <td>@c.CodCidade</td>
                                    <td>@c.Cidade</td>
                                    <td>@c.oEstado?.UF</td>
                                    <td class="text-end">@c.DDD</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelecionarCidade(c)">
                                            Selecionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@* Modal Confirmação de Exclusão *@
@if (modalExcluirAberto && clienteExcluir != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalExcluir"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">Tem certeza que deseja excluir este cliente? Esta ação não pode ser desfeita.</p>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr><th>Código</th><td>@clienteExcluir.CodPessoa</td></tr>
                            <tr><th>Nome</th><td>@clienteExcluir.Nome</td></tr>
                            <tr><th>CPF</th><td>@clienteExcluir.CPF</td></tr>
                            <tr><th>Email</th><td>@clienteExcluir.Email</td></tr>
                            <tr><th>Telefone</th><td>@clienteExcluir.Telefone</td></tr>
                            <tr><th>Nascimento</th><td>@clienteExcluir.DataNascimento.ToString("dd/MM/yyyy")</td></tr>
                            <tr><th>Cidade</th><td>@clienteExcluir.oCidade?.Cidade</td></tr>
                            <tr><th>Cadastro</th><td>@clienteExcluir.DataCadastro.ToString("dd/MM/yyyy")</td></tr>
                            <tr><th>Total Visitas</th><td>@clienteExcluir.TotalVisitas</td></tr>
                            <tr><th>Total Gasto</th><td>@clienteExcluir.TotalGasto.ToString("C2")</td></tr>
                            
                            <tr><th>Ativo</th><td>@(clienteExcluir.Ativo ? "Sim" : "Não")</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalExcluir">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusao">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Clientes> listaClientes = new();
    private List<Cidades> listaCidades = new();
    private Clientes clienteAtual = new();
    private Clientes? clienteExcluir;
    private bool modalFormAberto = false;
    private bool modalExcluirAberto = false;
    private string? mensagemErro;
    private string? mensagemSucesso;
    private string? mensagemErroModal;
    private List<CondicaoPagamento> listaCondicoes = new();
    private List<Estados> listaEstados = new();
    private Cidades novaCidade = new();
    private bool modalCidadesAberto;
    private bool cadastroCidadeAberto;
    private string termoCidade = string.Empty;
    private string? erroNovaCidade;

    private IEnumerable<Cidades> CidadesFiltradas
    {
        get
        {
            if (string.IsNullOrWhiteSpace(termoCidade)) return listaCidades;

            var termo = termoCidade.Trim().ToUpper();
            return listaCidades.Where(c =>
                c.CodCidade.ToString() == termo ||
                (c.Cidade ?? "").ToUpper().Contains(termo) ||
                (c.oEstado?.UF ?? "").ToUpper() == termo);
        }
    }

    private string CidadeSelecionadaTexto
    {
        get
        {
            var cidade = listaCidades.FirstOrDefault(c => c.CodCidade == clienteAtual.CodCidade);
            return cidade == null ? "" : $"{cidade.CodCidade} - {cidade.Cidade} - {cidade.oEstado?.UF}";
        }
    }

    private void AbrirConsultaCidades()
    {
        termoCidade = string.Empty;
        cadastroCidadeAberto = false;
        erroNovaCidade = null;
        modalCidadesAberto = true;
    }

    private void SelecionarCidade(Cidades cidade)
    {
        clienteAtual.CodCidade = cidade.CodCidade;
        modalCidadesAberto = false;
    }

    protected override async Task OnInitializedAsync()
    {
        listaCidades = await cidadesService.GetCidadesAsync();
        listaCondicoes = await condicaoPagamentoService.GetCondicoesPagamentoAsync();
        listaEstados = await estadosService.GetEstadosAsync();
        await CarregarClientes();
    }

    private async Task CarregarClientes()
    {
        listaClientes = await clientesService.GetClientesAsync();
    }

    private void AbrirModalNovo()
    {
        clienteAtual = new Clientes();
        mensagemErroModal = null;
        modalFormAberto = true;
    }

    private void AbrirModalEditar(Clientes c)
    {
        clienteAtual = new Clientes
        {
            CodPessoa = c.CodPessoa,
            Nome = c.Nome,
            CPF = c.CPF,
            Email = c.Email,
            Telefone = c.Telefone,
            DataNascimento = c.DataNascimento,
            DataCadastro = c.DataCadastro,
            Ativo = c.Ativo,
            CodCidade = c.CodCidade,
            TotalVisitas = c.TotalVisitas,
            TotalGasto = c.TotalGasto,
            Observacoes = c.Observacoes,
            UltimaVisita = c.UltimaVisita,
            RecebeNotificacoes = c.RecebeNotificacoes,
            CEP = c.CEP,
            Logradouro = c.Logradouro,
            Numero = c.Numero,
            Bairro = c.Bairro,
            Complemento = c.Complemento,
            PessoaJuridica = c.PessoaJuridica,
            CodCondicaoPagamento = c.CodCondicaoPagamento,
            DataUltimaAlteracao = c.DataUltimaAlteracao,
            UsuarioUltimaAlteracao = c.UsuarioUltimaAlteracao
        };
        mensagemErroModal = null;
        modalFormAberto = true;
    }

    private void AlterarTipoPessoa(ChangeEventArgs e)
    {
        clienteAtual.PessoaJuridica = e.Value?.ToString() == "J";
        clienteAtual.CPF = string.Empty;
    }

    private void FecharModalForm()
    {
        modalFormAberto = false;
        clienteAtual = new Clientes();
        mensagemErroModal = null;
    }

    private void AbrirModalExcluir(Clientes c)
    {
        clienteExcluir = c;
        modalExcluirAberto = true;
    }

    private void FecharModalExcluir()
    {
        modalExcluirAberto = false;
        clienteExcluir = null;
    }

    private async Task Salvar()
    {
        LimparMensagens();
        try
        {
            if (clienteAtual.CodPessoa == 0)
                await clientesService.AddClienteAsync(clienteAtual);
            else
                await clientesService.UpdateClienteAsync(clienteAtual);

            mensagemSucesso = "Cliente salvo com sucesso.";
            FecharModalForm();
            await CarregarClientes();
        }
        catch (Exception ex)
        {
            mensagemErroModal = ex.Message;
        }
    }

    private async Task SalvarNovaCidade()
    {
        erroNovaCidade = null;
        if (string.IsNullOrWhiteSpace(novaCidade.Cidade))
        {
            erroNovaCidade = "Nome é obrigatório.";
            return;
        }
        if (novaCidade.CodEstado == 0)
        {
            erroNovaCidade = "Selecione um estado.";
            return;
        }
        try
        {
            await cidadesService.AddCidadeAsync(novaCidade);
            listaCidades = await cidadesService.GetCidadesAsync();
            var criada = listaCidades.FirstOrDefault(c => c.Cidade == novaCidade.Cidade.ToUpper() && c.CodEstado == novaCidade.CodEstado);
            novaCidade = new Cidades();
            cadastroCidadeAberto = false;
            if (criada != null) SelecionarCidade(criada);
        }
        catch (Exception ex)
        {
            erroNovaCidade = ex.Message;
        }
    }

    private async Task ConfirmarExclusao()
    {
        if (clienteExcluir == null) return;
        LimparMensagens();
        try
        {
            await clientesService.DeleteClienteAsync(clienteExcluir.CodPessoa);
            mensagemSucesso = "Cliente excluído com sucesso.";
            FecharModalExcluir();
            await CarregarClientes();
        }
        catch (Exception ex)
        {
            mensagemErro = ex.Message;
            FecharModalExcluir();
        }
    }

    private void LimparMensagens()
    {
        mensagemErro = null;
        mensagemSucesso = null;
    }
}